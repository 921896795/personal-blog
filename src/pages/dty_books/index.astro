</style>

<script>
  type Entry = { id: number; t: string; s: string | null; d: string; st: string };

  const YEAR_COLORS = ["#7d8fa6", "#2f6f73", "#c98a4b", "#7d68a6", "#b36179"];

  const payload = JSON.parse(document.getElementById("bks-data")?.textContent ?? "{}") as {
    stats: { latest: string | null };
    entries: Entry[];
  };

  const entries = payload.entries;
  const lastEl = document.getElementById("bks-last") as HTMLElement;
  const presetsEl = document.getElementById("bks-presets") as HTMLElement;
  const monthEl = document.getElementById("bks-month") as HTMLSelectElement;
  const startEl = document.getElementById("bks-start") as HTMLInputElement;
  const endEl = document.getElementById("bks-end") as HTMLInputElement;
  const summaryEl = document.getElementById("bks-summary") as HTMLElement;
  const statTotalEl = document.getElementById("bks-stat-total") as HTMLElement;
  const statMonthsEl = document.getElementById("bks-stat-months") as HTMLElement;
  const statPeakEl = document.getElementById("bks-stat-peak") as HTMLElement;
  const statSpanEl = document.getElementById("bks-stat-span") as HTMLElement;
  const chartTitleEl = document.getElementById("bks-chart-title") as HTMLElement;
  const chartSubEl = document.getElementById("bks-chart-sub") as HTMLElement;
  const chartEl = document.getElementById("bks-chart") as HTMLElement;
  const chartMetaEl = document.getElementById("bks-chart-meta") as HTMLElement;
  const shelfEl = document.getElementById("bks-shelf") as HTMLElement;
  const shelfMetaEl = document.getElementById("bks-shelf-meta") as HTMLElement;

  const pad = (value: string) => value.padStart(2, "0");
  const toDate = (value: string) => {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(year, month - 1, day);
  };
  const toISO = (date: Date) =>
    `${date.getFullYear()}-${pad(String(date.getMonth() + 1))}-${pad(String(date.getDate()))}`;
  const shiftDays = (value: string, delta: number) => {
    const date = toDate(value);
    date.setDate(date.getDate() + delta);
    return toISO(date);
  };
  const monthEnd = (month: string) => {
    const [year, index] = month.split("-").map(Number);
    return toISO(new Date(year, index, 0));
  };
  const monthCount = (start: string, stop: string) => {
    const [startYear, startMonth] = start.split("-").map(Number);
    const [endYear, endMonth] = stop.split("-").map(Number);
    return Math.max(1, (endYear - startYear) * 12 + (endMonth - startMonth) + 1);
  };
  const weekStart = (value: string) => shiftDays(value, -((toDate(value).getDay() + 6) % 7));
  const today = toISO(new Date());

  const allDates = entries.map(entry => entry.d).sort();
  const minDate = allDates[0] ?? "";
  const maxDate = allDates[allDates.length - 1] ?? "";
  let rangeStart = `${today.slice(0, 7)}-01`;
  let rangeEnd = monthEnd(today.slice(0, 7));
  let activePreset: string | null = "month";

  const rangeEntries = () => entries.filter(entry => entry.d >= rangeStart && entry.d <= rangeEnd);
  const yearColor = (year: string) => {
    const years = [...new Set(allDates.map(day => day.slice(0, 4)))].sort();
    const index = years.indexOf(year);
    return YEAR_COLORS[(index < 0 ? 0 : index) % YEAR_COLORS.length];
  };

  function renderLast() {
    lastEl.innerHTML = `最近读完 · <b>${payload.stats.latest ?? "—"}</b>`;
  }

  function renderStats() {
    const ranged = rangeEntries();
    const buckets = new Map<string, number>();
    for (const entry of ranged) {
      const key = entry.d.slice(0, 7);
      buckets.set(key, (buckets.get(key) ?? 0) + 1);
    }

    const months = rangeStart && rangeEnd ? monthCount(rangeStart, rangeEnd) : 0;
    const peak = Math.max(...buckets.values(), 0);

    statTotalEl.innerHTML = `${ranged.length}<small>本</small>`;
    statMonthsEl.innerHTML = `${buckets.size}<small>个月</small>`;
    statPeakEl.innerHTML = `${peak}<small>本</small>`;
    statSpanEl.innerHTML = `${rangeStart ? rangeStart.slice(0, 7) : "—"} ~ ${rangeEnd ? rangeEnd.slice(0, 7) : "—"}<small>${months} 个月</small>`;
  }

  function renderSummary() {
    const ranged = rangeEntries();
    if (!ranged.length) {
      summaryEl.innerHTML = `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b> · 所选区间没有读完的书`;
      return;
    }

    summaryEl.innerHTML = [
      `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b>`,
      `共读完 <b>${ranged.length}</b> 本`,
      `月均 <b>${(ranged.length / Math.max(1, monthCount(rangeStart, rangeEnd))).toFixed(1)}</b> 本`
    ].join(" · ");
  }

  function renderChart() {
    const ranged = rangeEntries();
    // 区间本身只跨一个月时按天铺满，否则按月
    const daily = monthCount(rangeStart, rangeEnd) <= 1;

    chartTitleEl.textContent = daily ? "每日读完" : "阅读节奏";
    chartSubEl.textContent = daily
      ? "所选区间内每天读完的书本数"
      : "每个月读完的书本数，按年份着色";

    if (!ranged.length) {
      chartEl.innerHTML = `<p class="bks-empty">暂无数据</p>`;
      chartMetaEl.textContent = "—";
      return;
    }

    const counts = new Map<string, number>();
    const titles = new Map<string, string[]>();
    for (const entry of ranged) {
      const key = daily ? entry.d : entry.d.slice(0, 7);
      counts.set(key, (counts.get(key) ?? 0) + 1);
      const list = titles.get(key) ?? [];
      list.push(entry.t);
      titles.set(key, list);
    }

    const keys: string[] = [];
    if (daily) {
      for (let cursor = rangeStart; cursor <= rangeEnd; cursor = shiftDays(cursor, 1)) keys.push(cursor);
    } else {
      let year = Number(rangeStart.slice(0, 4));
      let month = Number(rangeStart.slice(5, 7));
      const endYear = Number(rangeEnd.slice(0, 4));
      const endMonth = Number(rangeEnd.slice(5, 7));
      while (year < endYear || (year === endYear && month <= endMonth)) {
        keys.push(`${year}-${pad(String(month))}`);
        month += 1;
        if (month > 12) {
          month = 1;
          year += 1;
        }
      }
    }

    const max = Math.max(...keys.map(key => counts.get(key) ?? 0), 1);

    chartEl.innerHTML = keys
      .map((key, index) => {
        const count = counts.get(key) ?? 0;
        const height = count ? Math.max(6, (count / max) * 100) : 0;
        const color = yearColor(key.slice(0, 4));
        const showYear = daily
          ? index === 0
          : index === 0 || key.slice(5, 7) === "01";
        const list = titles.get(key) ?? [];
        const tooltip = `${key} · ${count} 本${list.length ? ` · ${list.slice(0, 3).join("、")}${list.length > 3 ? ` 等 ${list.length} 本` : ""}` : ""}`;
        return `<div class="bks-col" style="--yc:${color}" title="${tooltip}">
          <div class="bks-col-bar${count ? "" : " is-empty"}" style="height:${height.toFixed(1)}%"></div>
          <span class="bks-col-label">${daily ? key.slice(8, 10) : key.slice(5, 7)}</span>
          <span class="bks-col-year">${showYear ? (daily ? key.slice(0, 7) : key.slice(0, 4)) : ""}</span>
        </div>`;
      })
      .join("");

    const peakKey = keys.reduce((best, key) => ((counts.get(key) ?? 0) > (counts.get(best) ?? 0) ? key : best));
    chartMetaEl.textContent = `峰值 ${daily ? peakKey.slice(5) : peakKey} · ${counts.get(peakKey) ?? 0} 本 · ${keys.length} ${daily ? "天" : "个月"}`;
  }

  function renderShelf() {
    const ranged = rangeEntries();
    if (!ranged.length) {
      shelfEl.innerHTML = `<p class="bks-empty">所选区间还没有读完的书。</p>`;
      shelfMetaEl.textContent = "—";
      return;
    }

    const groups = new Map<string, Entry[]>();
    for (const entry of ranged) {
      const month = entry.d.slice(0, 7);
      const list = groups.get(month) ?? [];
      list.push(entry);
      groups.set(month, list);
    }

    const months = [...groups.keys()].sort().reverse();
    shelfEl.innerHTML = months
      .map(month => {
        const list = (groups.get(month) ?? []).sort((a, b) => b.d.localeCompare(a.d));
        const cards = list
          .map((entry, index) => {
            const color = yearColor(entry.d.slice(0, 4));
            return `<article class="bks-book" style="--c:${color}">
              <span class="bks-spine"></span>
              <div class="bks-book-head">
                <span class="bks-no">NO.${String(list.length - index).padStart(2, "0")}</span>
                <span class="bks-tag">${entry.st}</span>
              </div>
              <h3 class="bks-name" title="${entry.t.replace(/</g, "&lt;")}">${entry.t.replace(/</g, "&lt;")}</h3>
              <div class="bks-book-foot">
                <span>${entry.d}</span>
                <span>#${entry.id}</span>
              </div>
            </article>`;
          })
          .join("");
        return `<div class="bks-month"><span>${month.slice(0, 4)} 年 ${month.slice(5, 7)} 月</span><b>${list.length} 本</b></div>
          <div class="bks-grid">${cards}</div>`;
      })
      .join("");

    shelfMetaEl.textContent = `${months.length} 个月 · 共 ${ranged.length} 本`;
  }

  function syncInputs() {
    startEl.value = rangeStart;
    endEl.value = rangeEnd;

    const wholeMonth =
      rangeStart &&
      rangeEnd &&
      rangeStart.slice(0, 7) === rangeEnd.slice(0, 7) &&
      rangeStart.endsWith("-01") &&
      rangeEnd === monthEnd(rangeStart.slice(0, 7));
    monthEl.value = wholeMonth ? rangeStart.slice(0, 7) : "all";

    for (const button of presetsEl.querySelectorAll<HTMLButtonElement>("button")) {
      button.setAttribute("aria-pressed", String(button.dataset.preset === activePreset));
    }
  }

  function renderMonths() {
    const months = [...new Set([...entries.map(entry => entry.d.slice(0, 7)), today.slice(0, 7)])].sort().reverse();
    monthEl.innerHTML =
      `<option value="all">全部</option>` +
      months
        .map(month => `<option value="${month}">${month.slice(0, 4)} 年 ${month.slice(5, 7)} 月</option>`)
        .join("");
  }

  function renderAll() {
    renderStats();
    renderSummary();
    renderChart();
    renderShelf();
  }

  function applyPreset(key: string) {
    activePreset = key;
    if (key === "week") {
      rangeStart = weekStart(today);
      rangeEnd = shiftDays(rangeStart, 6);
    } else if (key === "last7") {
      rangeStart = shiftDays(maxDate, -6);
      rangeEnd = maxDate;
    } else if (key === "last30") {
      rangeStart = shiftDays(maxDate, -29);
      rangeEnd = maxDate;
    } else if (key === "month") {
      rangeStart = `${today.slice(0, 7)}-01`;
      rangeEnd = monthEnd(today.slice(0, 7));
    } else if (key === "year") {
      rangeStart = `${today.slice(0, 4)}-01-01`;
      rangeEnd = today;
    } else {
      rangeStart = minDate;
      rangeEnd = maxDate;
    }

    syncInputs();
    renderAll();
  }

  presetsEl.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-preset]");
    if (button?.dataset.preset) applyPreset(button.dataset.preset);
  });

  monthEl.addEventListener("change", () => {
    const value = monthEl.value;
    if (value === "all") {
      rangeStart = minDate;
      rangeEnd = maxDate;
      activePreset = null;
    } else {
      rangeStart = `${value}-01`;
      rangeEnd = monthEnd(value);
      activePreset = value === today.slice(0, 7) ? "month" : null;
    }
    syncInputs();
    renderAll();
  });

  const onDateChange = () => {
    let start = startEl.value || minDate;
    let stop = endEl.value || maxDate;
    if (start > stop) [start, stop] = [stop, start];
    rangeStart = start;
    rangeEnd = stop;
    activePreset = null;
    syncInputs();
    renderAll();
  };

  startEl.addEventListener("change", onDateChange);
  endEl.addEventListener("change", onDateChange);

  renderLast();
  renderMonths();
  applyPreset("month");
</script>
