---
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Entry = { id: number; t: string; s: string | null; d: string; st: string };
type Payload = {
  syncedAt: string;
  stats: {
    total: number;
    months: number;
    years: number;
    start: string | null;
    end: string | null;
    latest: string | null;
  };
  entries: Entry[];
};

const dataPath = resolve(process.cwd(), "public/data/books.json");
const data: Payload = existsSync(dataPath)
  ? JSON.parse(readFileSync(dataPath, "utf8"))
  : {
      syncedAt: "",
      stats: { total: 0, months: 0, years: 0, start: null, end: null, latest: null },
      entries: []
    };

// 首屏按默认区间（当前自然月）渲染，与客户端初始筛选一致
const now = new Date();
const currentMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
const initialStart = `${currentMonth}-01`;
const initialEnd = (() => {
  const [year, index] = currentMonth.split("-").map(Number);
  const last = new Date(year, index, 0);
  return `${year}-${String(last.getMonth() + 1).padStart(2, "0")}-${String(last.getDate()).padStart(2, "0")}`;
})();
const initialEntries = data.entries.filter(entry => entry.d >= initialStart && entry.d <= initialEnd);
const initialSpan = `${currentMonth} ~ ${currentMonth}`;

const syncedLabel = data.syncedAt
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    }).format(new Date(data.syncedAt))
  : "—";
---

<BaseLayout title="读书" description="按读完时间记录的读书书架">
  <section class="container bks-hero">
    <p class="eyebrow">Reading Shelf</p>
    <h1 class="bks-title">读书</h1>
    <p class="lead bks-lead">每读完一本，就往书架上放一本。</p>
    <p class="bks-last" id="bks-last">
      最近读完 · <b>{data.stats.latest ?? "—"}</b>
    </p>

    <dl class="bks-stats">
      <div>
        <dt>读完书数</dt>
        <dd id="bks-stat-total">{initialEntries.length}<small>本</small></dd>
      </div>
      <div>
        <dt>涉及月份</dt>
        <dd id="bks-stat-months">0<small>个月</small></dd>
      </div>
      <div>
        <dt>单月最多</dt>
        <dd id="bks-stat-peak">0<small>本</small></dd>
      </div>
      <div>
        <dt>记录跨度</dt>
        <dd class="bks-span" id="bks-stat-span">{initialSpan}<small>1 个月</small></dd>
      </div>
    </dl>
  </section>

  <section class="container">
    <div class="bks-range-bar">
      <div class="bks-chips" id="bks-presets" role="group" aria-label="时间范围">
        <button type="button" data-preset="week" aria-pressed="false">本周</button>
        <button type="button" data-preset="last7" aria-pressed="false">近 7 天</button>
        <button type="button" data-preset="last30" aria-pressed="false">近 30 天</button>
        <button type="button" data-preset="month" aria-pressed="true">本月</button>
        <button type="button" data-preset="year" aria-pressed="false">本年</button>
        <button type="button" data-preset="all" aria-pressed="false">全部</button>
      </div>

      <div class="bks-pickers">
        <label>
          月份
          <select id="bks-month">
            <option value="all">全部</option>
          </select>
        </label>
        <label>
          起
          <input type="date" id="bks-start" />
        </label>
        <label>
          止
          <input type="date" id="bks-end" />
        </label>
      </div>
    </div>

    <p class="bks-summary" id="bks-summary">—</p>
  </section>

  <section class="container bks-panel-wrap">
    <div class="bks-panel">
      <header class="bks-panel-head">
        <div>
          <h2 id="bks-chart-title">阅读节奏</h2>
          <p class="muted" id="bks-chart-sub">每个月读完的书本数，按年份着色</p>
        </div>
        <span class="bks-meta" id="bks-chart-meta">—</span>
      </header>
      <div class="bks-chart-wrap">
        <div class="bks-chart" id="bks-chart"></div>
      </div>
    </div>
  </section>

  <section class="container bks-panel-wrap">
    <div class="bks-panel">
      <header class="bks-panel-head">
        <div>
          <h2>书架</h2>
          <p class="muted">按读完月份分组，书脊颜色对应年份</p>
        </div>
        <span class="bks-meta" id="bks-shelf-meta">—</span>
      </header>
      <div class="bks-shelf" id="bks-shelf">
        <p class="bks-empty">正在载入…</p>
      </div>
    </div>
  </section>

  <section class="container">
    <p class="bks-source">
      数据来源：MySQL 表 <code>dty_books</code> · 最近同步 {syncedLabel}
    </p>
  </section>
</BaseLayout>

<script type="application/json" id="bks-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

<style is:global>
  .bks-hero {
    padding-bottom: 10px;
  }

  .bks-title {
    font-size: clamp(2.6rem, 9vw, 5rem);
    letter-spacing: -0.02em;
  }

  .bks-lead {
    margin-top: 14px;
  }

  .bks-last {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
