---
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Entry = { d: string; a: number; c: string; n: string | null };
type Payload = {
  syncedAt: string;
  stats: {
    total: number;
    count: number;
    months: number;
    start: string | null;
    end: string | null;
    avgMonthly: number;
  };
  entries: Entry[];
};

const dataPath = resolve(process.cwd(), "public/data/daily-expense.json");
const data: Payload = existsSync(dataPath)
  ? JSON.parse(readFileSync(dataPath, "utf8"))
  : {
      syncedAt: "",
      stats: { total: 0, count: 0, months: 0, start: null, end: null, avgMonthly: 0 },
      entries: []
    };

const money = (value: number) =>
  `¥${value.toLocaleString("zh-CN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

const monthEnd = (month: string) => {
  const [year, index] = month.split("-").map(Number);
  const last = new Date(year, index, 0);
  return `${last.getFullYear()}-${String(last.getMonth() + 1).padStart(2, "0")}-${String(last.getDate()).padStart(2, "0")}`;
};

// 首屏按默认区间（当前自然月）渲染，与客户端初始筛选一致
const now = new Date();
const currentMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
const initialStart = `${currentMonth}-01`;
const initialEnd = monthEnd(currentMonth);
const initialEntries = data.entries.filter(entry => entry.d >= initialStart && entry.d <= initialEnd);
const initialTotal = initialEntries.reduce((sum, entry) => sum + entry.a, 0);
const initialDays = Number(initialEnd.slice(8, 10));
const initialSpan = `${currentMonth} ~ ${currentMonth}`;

const syncedLabel = data.syncedAt
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    }).format(new Date(data.syncedAt))
  : "—";
---

<BaseLayout title="支出" description="按日期记录的支出账本">
  <section class="container exp-hero">
    <p class="eyebrow">Expense Ledger</p>
    <h1 class="exp-title">支出</h1>
    <p class="lead exp-lead">每一笔花出去的钱，都记在这里。</p>

    <dl class="exp-stats">
      <div>
        <dt>累计支出</dt>
        <dd id="exp-stat-total">{money(initialTotal)}</dd>
      </div>
      <div>
        <dt>记录笔数</dt>
        <dd id="exp-stat-count">{initialEntries.length}<small>笔</small></dd>
      </div>
      <div>
        <dt>日均支出</dt>
        <dd id="exp-stat-avg">{money(initialDays ? initialTotal / initialDays : 0)}</dd>
      </div>
      <div>
        <dt>跨度</dt>
        <dd class="exp-span" id="exp-stat-span">{initialSpan}<small>1 个月</small></dd>
      </div>
    </dl>
  </section>

  <section class="container">
    <div class="exp-range-bar">
      <div class="exp-chips" id="exp-presets" role="group" aria-label="时间范围">
        <button type="button" data-preset="week" aria-pressed="false">本周</button>
        <button type="button" data-preset="last7" aria-pressed="false">近 7 天</button>
        <button type="button" data-preset="last30" aria-pressed="false">近 30 天</button>
        <button type="button" data-preset="month" aria-pressed="true">本月</button>
        <button type="button" data-preset="year" aria-pressed="false">本年</button>
        <button type="button" data-preset="all" aria-pressed="false">全部</button>
      </div>

      <div class="exp-pickers">
        <label>
          月份
          <select id="exp-month">
            <option value="all">全部</option>
          </select>
        </label>
        <label>
          起
          <input type="date" id="exp-start" />
        </label>
        <label>
          止
          <input type="date" id="exp-end" />
        </label>
      </div>
    </div>

    <p class="exp-summary" id="exp-summary">—</p>
  </section>

  <section class="container exp-panel-wrap">
    <div class="exp-panel">
      <header class="exp-panel-head">
        <div>
          <h2 id="exp-chart-title">月度趋势</h2>
          <p class="muted" id="exp-chart-sub">每个月的支出总额，按年份着色</p>
        </div>
        <span class="exp-meta" id="exp-chart-meta">—</span>
      </header>
      <div class="exp-chart-wrap">
        <div class="exp-chart" id="exp-chart"></div>
      </div>
    </div>
  </section>

  <section class="container exp-panel-wrap">
    <div class="exp-panel">
      <header class="exp-panel-head">
        <div>
          <h2>分类构成</h2>
          <p class="muted">点击分类可隐藏或恢复，趋势图与流水会同步刷新</p>
        </div>
        <span class="exp-meta" id="exp-cat-meta">—</span>
      </header>
      <div class="exp-cats" id="exp-cats"></div>
    </div>
  </section>

  <section class="container">
    <div class="exp-list" id="exp-list">
      <p class="exp-empty">正在载入…</p>
    </div>

    <div class="exp-more">
      <button type="button" id="exp-more" hidden>加载更多</button>
    </div>

    <p class="exp-source">
      数据来源：MySQL 表 <code>dty_daily_expense_v2</code> · 最近同步 {syncedLabel}
    </p>
  </section>
</BaseLayout>

<script type="application/json" id="exp-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

<style is:global>
