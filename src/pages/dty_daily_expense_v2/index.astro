    font-weight: 700;
    white-space: nowrap;
  }

  .exp-tag i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
  }

  .exp-note {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.84rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .exp-amount {
    font-size: 1rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .exp-empty {
    padding: 40px 0;
    color: var(--muted);
    text-align: center;
  }

  .exp-more {
    display: flex;
    justify-content: center;
    margin-top: 18px;
  }

  .exp-more button {
    padding: 9px 26px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .exp-more button:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .exp-source {
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px dashed var(--line);
    color: var(--muted);
    font-size: 0.8rem;
  }

  .exp-source code {
    color: var(--accent-strong);
  }

  @media (max-width: 700px) {
    .exp-row {
      grid-template-columns: 56px minmax(0, 1fr) auto;
      grid-template-areas:
        "date note amount"
        "date tag amount";
      gap: 4px 12px;
      padding: 12px 14px;
    }

    .exp-date {
      grid-area: date;
    }

    .exp-tag {
      grid-area: tag;
    }

    .exp-note {
      grid-area: note;
    }

    .exp-amount {
      grid-area: amount;
    }

    .exp-cat {
      grid-template-columns: 10px minmax(64px, 1fr) 84px 46px;
    }

    .exp-cat .track {
      display: none;
    }

    .exp-summary {
      margin-left: 0;
    }

    .exp-panel {
      padding: 16px;
    }
  }
</style>

<script>
  type Entry = { d: string; a: number; c: string; n: string | null };

  const CATS: Record<string, { label: string; color: string }> = {
    d_food: { label: "餐饮", color: "#c98a4b" },
    d_bb_share: { label: "和 bb 一起", color: "#b36179" },
    d_bb_only: { label: "bb 专属", color: "#8f5f7a" },
    d_commute: { label: "通勤", color: "#7d8fa6" },
    d_housing: { label: "住房", color: "#5f7fa8" },
    d_daily_use: { label: "日用", color: "#918577" },
    p_clothing: { label: "服饰", color: "#6f8f66" },
    p_health: { label: "健康", color: "#7f8f4e" },
    p_home_trip: { label: "探亲", color: "#a95f3c" },
    p_entertain: { label: "娱乐", color: "#7d68a6" },
    p_big_item: { label: "大件", color: "#4f7f8c" },
    s_travel: { label: "旅行", color: "#2f6f73" },
    s_gift: { label: "人情", color: "#c05f5a" }
  };

  const YEAR_COLORS = ["#2f6f73", "#6f8f66", "#c98a4b", "#7d68a6", "#b36179"];
  const WEEKDAYS = ["日", "一", "二", "三", "四", "五", "六"];
  const PAGE_SIZE = 60;

  const payload = JSON.parse(document.getElementById("exp-data")?.textContent ?? "{}") as {
    stats: { total: number; count: number };
    entries: Entry[];
  };

  const entries = payload.entries;
  const years = [...new Set(entries.map(entry => entry.d.slice(0, 4)))].sort().reverse();
  const yearColor = (year: string) => {
    const ascending = [...years].sort();
    const index = ascending.indexOf(year);
    return YEAR_COLORS[(index < 0 ? 0 : index) % YEAR_COLORS.length];
  };

  const yearsEl = document.getElementById("exp-years") as HTMLElement;
  const summaryEl = document.getElementById("exp-summary") as HTMLElement;
  const chartEl = document.getElementById("exp-chart") as HTMLElement;
  const chartMetaEl = document.getElementById("exp-chart-meta") as HTMLElement;
  const catsEl = document.getElementById("exp-cats") as HTMLElement;
  const catMetaEl = document.getElementById("exp-cat-meta") as HTMLElement;
  const listEl = document.getElementById("exp-list") as HTMLElement;
  const moreBtn = document.getElementById("exp-more") as HTMLButtonElement;

  let activeYear = "all";
  let limit = PAGE_SIZE;
  const hidden = new Set<string>();

  const money = (value: number) =>
    `¥${value.toLocaleString("zh-CN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

  const byYear = () => entries.filter(entry => activeYear === "all" || entry.d.startsWith(activeYear));
  const filtered = () => byYear().filter(entry => !hidden.has(entry.c));

  function renderYears() {
    const items = [["all", "全部"], ...years.map(year => [year, year])];
    yearsEl.innerHTML = items
      .map(
        ([value, label]) =>
          `<button type="button" data-year="${value}" aria-pressed="${String(value === activeYear)}">${label}</button>`
      )
      .join("");
  }

  function renderSummary() {
    const list = filtered();
    const total = list.reduce((sum, entry) => sum + entry.a, 0);
    const dates = list.map(entry => entry.d).sort();

    summaryEl.innerHTML = list.length
      ? `${dates[0]} ~ ${dates[dates.length - 1]} · <b>${list.length}</b> 笔 · 合计 <b>${money(total)}</b> · 笔均 <b>${money(total / list.length)}</b>`
      : "所选筛选下没有记录";
  }

  function renderChart() {
    const list = filtered();
    const months = new Map<string, number>();
    for (const entry of list) {
      const month = entry.d.slice(0, 7);
      months.set(month, (months.get(month) ?? 0) + entry.a);
    }

    const keys = [...months.keys()].sort();
    const max = Math.max(...keys.map(key => months.get(key) ?? 0), 0);

    if (!keys.length) {
      chartEl.innerHTML = `<p class="exp-empty">暂无数据</p>`;
      chartMetaEl.textContent = "—";
      return;
    }

    chartEl.innerHTML = keys
      .map((key, index) => {
        const amount = months.get(key) ?? 0;
        const height = max ? Math.max(3, (amount / max) * 100) : 3;
        const year = key.slice(0, 4);
        const month = key.slice(5, 7);
        const showYear = index === 0 || month === "01";
        return `<div class="exp-col" style="--yc:${yearColor(year)}" title="${key} · ${money(amount)}">
          <div class="exp-col-bar" style="height:${height.toFixed(1)}%"></div>
          <span class="exp-col-label">${month} 月</span>
          <span class="exp-col-year">${showYear ? year : ""}</span>
        </div>`;
      })
      .join("");

    const peakKey = keys.reduce((best, key) =>
      (months.get(key) ?? 0) > (months.get(best) ?? 0) ? key : best
    );
    chartMetaEl.textContent = `峰值 ${peakKey} · ${money(months.get(peakKey) ?? 0)} · ${keys.length} 个月`;
  }

  function renderCats() {
    const list = byYear();
    const totals = new Map<string, number>();
    for (const entry of list) totals.set(entry.c, (totals.get(entry.c) ?? 0) + entry.a);

    const total = [...totals.values()].reduce((sum, value) => sum + value, 0) || 1;
    const rows = [...totals.entries()].sort((a, b) => b[1] - a[1]);
    const max = rows[0]?.[1] ?? 1;

    catsEl.innerHTML = rows
      .map(([key, amount]) => {
        const meta = CATS[key] ?? { label: key, color: "#98a4b0" };
        const pressed = String(!hidden.has(key));
        return `<button type="button" class="exp-cat" data-cat="${key}" aria-pressed="${pressed}" style="--c:${meta.color}">
          <span class="dot"></span>
          <span class="name">${meta.label}</span>
          <span class="track"><i style="width:${((amount / max) * 100).toFixed(1)}%"></i></span>
          <span class="amt">${money(amount)}</span>
          <span class="pct">${((amount / total) * 100).toFixed(1)}%</span>
        </button>`;
      })
      .join("");

    catMetaEl.textContent = rows.length ? `${rows.length} 个分类 · 合计 ${money(total)}` : "—";
  }

  function renderList() {
    const list = filtered();
    limit = Math.min(limit, Math.max(list.length, PAGE_SIZE));
    const visible = list.slice(0, limit);

    if (!visible.length) {
      listEl.innerHTML = `<p class="exp-empty">这个筛选下还没有记录。</p>`;
      moreBtn.hidden = true;
      return;
    }

    let lastMonth = "";
    const monthTotals = new Map<string, number>();
    for (const entry of list) {
      const month = entry.d.slice(0, 7);
      monthTotals.set(month, (monthTotals.get(month) ?? 0) + entry.a);
    }

    const html = visible
      .map(entry => {
        const month = entry.d.slice(0, 7);
        let header = "";
        if (month !== lastMonth) {
          lastMonth = month;
          header = `<div class="exp-month"><span>${entry.d.slice(0, 4)} 年 ${entry.d.slice(5, 7)} 月</span><b>${money(monthTotals.get(month) ?? 0)}</b></div>`;
        }
        return `${header}<article class="exp-row">${rowHtml(entry)}</article>`;
      })
      .join("");

    listEl.innerHTML = html;
    moreBtn.hidden = limit >= list.length;
  }

  function rowHtml(entry: Entry) {
    const meta = CATS[entry.c] ?? { label: entry.c, color: "#98a4b0" };
    const date = new Date(Number(entry.d.slice(0, 4)), Number(entry.d.slice(5, 7)) - 1, Number(entry.d.slice(8, 10)));
    const note = entry.n ? entry.n.replace(/</g, "&lt;") : "—";
    return `<div class="exp-date">
        <b>${entry.d.slice(5, 7)}-${entry.d.slice(8, 10)}</b>
        <span>周${WEEKDAYS[date.getDay()]}</span>
      </div>
      <span class="exp-tag" style="--c:${meta.color}"><i></i>${meta.label}</span>
      <span class="exp-note" title="${note}">${note}</span>
      <span class="exp-amount">${money(entry.a)}</span>`;
  }

  function renderAll() {
    renderSummary();
    renderChart();
    renderCats();
    renderList();
  }

  yearsEl.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-year]");
    if (!button) return;
    activeYear = button.dataset.year ?? "all";
    limit = PAGE_SIZE;
    yearsEl.querySelectorAll<HTMLButtonElement>("button").forEach(other => {
      other.setAttribute("aria-pressed", String(other === button));
    });
    renderAll();
  });

  catsEl.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-cat]");
    if (!button) return;
    const key = button.dataset.cat ?? "";
    if (hidden.has(key)) hidden.delete(key);
    else hidden.add(key);
    limit = PAGE_SIZE;
    renderAll();
  });

  moreBtn.addEventListener("click", () => {
    limit += PAGE_SIZE;
    renderList();
  });

  renderYears();
  renderAll();
</script>
