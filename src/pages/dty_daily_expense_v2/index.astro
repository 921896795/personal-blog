<script>
  type Entry = { d: string; a: number; c: string; n: string | null };

  const CATS: Record<string, { label: string; color: string }> = {
    d_food: { label: "餐饮", color: "#c98a4b" },
    d_bb_share: { label: "和 bb 一起", color: "#b36179" },
    d_bb_only: { label: "bb 专属", color: "#8f5f7a" },
    d_commute: { label: "通勤", color: "#7d8fa6" },
    d_housing: { label: "住房", color: "#5f7fa8" },
    d_daily_use: { label: "日用", color: "#918577" },
    p_clothing: { label: "服饰", color: "#6f8f66" },
    p_health: { label: "健康", color: "#7f8f4e" },
    p_home_trip: { label: "探亲", color: "#a95f3c" },
    p_entertain: { label: "娱乐", color: "#7d68a6" },
    p_big_item: { label: "大件", color: "#4f7f8c" },
    s_travel: { label: "旅行", color: "#2f6f73" },
    s_gift: { label: "人情", color: "#c05f5a" }
  };

  const YEAR_COLORS = ["#2f6f73", "#6f8f66", "#c98a4b", "#7d68a6", "#b36179"];
  const WEEKDAYS = ["日", "一", "二", "三", "四", "五", "六"];
  const PAGE_SIZE = 60;

  const payload = JSON.parse(document.getElementById("exp-data")?.textContent ?? "{}") as {
    stats: { total: number; count: number };
    entries: Entry[];
  };

  const entries = payload.entries;
  const allDates = entries.map(entry => entry.d).sort();
  const minDate = allDates[0] ?? "";
  const maxDate = allDates[allDates.length - 1] ?? "";

  const yearColor = (year: string) => {
    const ascending = [...new Set(entries.map(entry => entry.d.slice(0, 4)))].sort();
    const index = ascending.indexOf(year);
    return YEAR_COLORS[(index < 0 ? 0 : index) % YEAR_COLORS.length];
  };

  const presetsEl = document.getElementById("exp-presets") as HTMLElement;
  const monthEl = document.getElementById("exp-month") as HTMLSelectElement;
  const startEl = document.getElementById("exp-start") as HTMLInputElement;
  const endEl = document.getElementById("exp-end") as HTMLInputElement;
  const summaryEl = document.getElementById("exp-summary") as HTMLElement;
  const statTotalEl = document.getElementById("exp-stat-total") as HTMLElement;
  const statCountEl = document.getElementById("exp-stat-count") as HTMLElement;
  const statAvgEl = document.getElementById("exp-stat-avg") as HTMLElement;
  const statSpanEl = document.getElementById("exp-stat-span") as HTMLElement;
  const chartEl = document.getElementById("exp-chart") as HTMLElement;
  const chartTitleEl = document.getElementById("exp-chart-title") as HTMLElement;
  const chartSubEl = document.getElementById("exp-chart-sub") as HTMLElement;
  const chartMetaEl = document.getElementById("exp-chart-meta") as HTMLElement;
  const catsEl = document.getElementById("exp-cats") as HTMLElement;
  const catMetaEl = document.getElementById("exp-cat-meta") as HTMLElement;
  const listEl = document.getElementById("exp-list") as HTMLElement;
  const moreBtn = document.getElementById("exp-more") as HTMLButtonElement;

  let rangeStart = minDate;
  let rangeEnd = maxDate;
  let activePreset: string | null = "month";
  let limit = PAGE_SIZE;
  const hidden = new Set<string>();

  const money = (value: number) =>
    `¥${value.toLocaleString("zh-CN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

  const pad = (value: string) => value.padStart(2, "0");
  const toDate = (value: string) => {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(year, month - 1, day);
  };
  const toISO = (date: Date) =>
    `${date.getFullYear()}-${pad(String(date.getMonth() + 1))}-${pad(String(date.getDate()))}`;
  const shiftDays = (value: string, delta: number) => {
    const date = toDate(value);
    date.setDate(date.getDate() + delta);
    return toISO(date);
  };
  const monthEnd = (month: string) => {
    const [year, index] = month.split("-").map(Number);
    return toISO(new Date(year, index, 0));
  };
  const monthCount = (start: string, end: string) => {
    const [startYear, startMonth] = start.split("-").map(Number);
    const [endYear, endMonth] = end.split("-").map(Number);
    return Math.max(1, (endYear - startYear) * 12 + (endMonth - startMonth) + 1);
  };
  const dayCount = (start: string, end: string) => {
    const [startYear, startMonth, startDay] = start.split("-").map(Number);
    const [endYear, endMonth, endDay] = end.split("-").map(Number);
    const startDate = new Date(startYear, startMonth - 1, startDay);
    const endDate = new Date(endYear, endMonth - 1, endDay);
    return Math.max(1, Math.round((endDate.getTime() - startDate.getTime()) / 86400000) + 1);
  };
  const weekStart = (value: string) => shiftDays(value, -((toDate(value).getDay() + 6) % 7));
  const today = toISO(new Date());

  const inRange = (entry: Entry) => entry.d >= rangeStart && entry.d <= rangeEnd;
  const rangeList = () => entries.filter(inRange);
  const filtered = () => rangeList().filter(entry => !hidden.has(entry.c));

  function syncInputs() {
    startEl.value = rangeStart;
    endEl.value = rangeEnd;

    const sameMonth = rangeStart.slice(0, 7) === rangeEnd.slice(0, 7);
    const wholeMonth = sameMonth && rangeStart.endsWith("-01") && rangeEnd === monthEnd(rangeStart.slice(0, 7));
    monthEl.value = wholeMonth ? rangeStart.slice(0, 7) : "all";

    presetsEl.querySelectorAll<HTMLButtonElement>("button").forEach(button => {
      button.setAttribute("aria-pressed", String(button.dataset.preset === activePreset));
    });
  }

  function applyPreset(key: string) {
    activePreset = key;

    if (key === "week") {
      rangeStart = weekStart(today);
      rangeEnd = shiftDays(rangeStart, 6);
    } else if (key === "last7") {
      rangeStart = shiftDays(maxDate, -6);
      rangeEnd = maxDate;
    } else if (key === "last30") {
      rangeStart = shiftDays(maxDate, -29);
      rangeEnd = maxDate;
    } else if (key === "month") {
      rangeStart = `${today.slice(0, 7)}-01`;
      rangeEnd = monthEnd(today.slice(0, 7));
    } else if (key === "year") {
      rangeStart = `${today.slice(0, 4)}-01-01`;
      rangeEnd = today;
    } else {
      rangeStart = minDate;
      rangeEnd = maxDate;
    }

    limit = PAGE_SIZE;
    syncInputs();
    renderAll();
  }

  function renderMonths() {
    const months = [...new Set([...entries.map(entry => entry.d.slice(0, 7)), today.slice(0, 7)])].sort().reverse();
    monthEl.innerHTML = [
      `<option value="all">全部</option>`,
      ...months.map(month => `<option value="${month}">${month.slice(0, 4)} 年 ${month.slice(5, 7)} 月</option>`)
    ].join("");
  }

  function renderStats() {
    const list = rangeList();
    const total = list.reduce((sum, entry) => sum + entry.a, 0);
    const hasRange = Boolean(rangeStart && rangeEnd);
    const days = hasRange ? dayCount(rangeStart, rangeEnd) : 0;
    const months = hasRange ? monthCount(rangeStart, rangeEnd) : 0;

    statTotalEl.textContent = money(total);
    statCountEl.innerHTML = `${list.length}<small>笔</small>`;
    statAvgEl.textContent = money(days ? total / days : 0);
    statSpanEl.innerHTML = `${hasRange ? rangeStart.slice(0, 7) : "—"} ~ ${hasRange ? rangeEnd.slice(0, 7) : "—"}<small>${months} 个月</small>`;
  }

  function renderSummary() {
    const list = filtered();
    const total = list.reduce((sum, entry) => sum + entry.a, 0);

    summaryEl.innerHTML = list.length
      ? `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b> · 共 <b>${list.length}</b> 笔 · 合计 <b>${money(total)}</b> · 笔均 <b>${money(total / list.length)}</b>`
      : `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b> · 所选区间没有记录`;
  }

  function renderChart() {
    const list = filtered();
    const monthKeys = [...new Set(list.map(entry => entry.d.slice(0, 7)))];
    const daily = monthKeys.length <= 1;

    chartTitleEl.textContent = daily ? "每日趋势" : "月度趋势";
    chartSubEl.textContent = daily ? "所选区间内每天的支出" : "每个月的支出总额，按年份着色";

    if (!list.length) {
      chartEl.innerHTML = `<p class="exp-empty">暂无数据</p>`;
      chartMetaEl.textContent = "—";
      return;
    }

    const buckets = new Map<string, number>();
    for (const entry of list) {
      const key = daily ? entry.d : entry.d.slice(0, 7);
      buckets.set(key, (buckets.get(key) ?? 0) + entry.a);
    }

    // 单月视图按天铺满区间，没有记录的日子留空柱
    const keys: string[] = [];
    if (daily) {
      for (let cursor = rangeStart; cursor <= rangeEnd; cursor = shiftDays(cursor, 1)) keys.push(cursor);
    } else {
      keys.push(...[...buckets.keys()].sort());
    }

    const max = Math.max(...keys.map(key => buckets.get(key) ?? 0), 0);

    chartEl.innerHTML = keys
      .map((key, index) => {
        const amount = buckets.get(key) ?? 0;
        const height = max && amount > 0 ? Math.max(3, (amount / max) * 100) : 0;
        const year = key.slice(0, 4);
        const month = key.slice(5, 7);
        const showYear = !daily && (index === 0 || month === "01");
        const label = daily ? `${Number(key.slice(8, 10))} 日` : `${month} 月`;
        const empty = amount > 0 ? "" : " is-empty";
        return `<div class="exp-col" style="--yc:${yearColor(year)}" title="${key} · ${amount ? money(amount) : "无记录"}">
          <div class="exp-col-bar${empty}" style="height:${height.toFixed(1)}%"></div>
          <span class="exp-col-label">${label}</span>
          <span class="exp-col-year">${showYear ? year : ""}</span>
        </div>`;
      })
      .join("");

    const peakKey = keys.reduce((best, key) =>
      (buckets.get(key) ?? 0) > (buckets.get(best) ?? 0) ? key : best
    );
    chartMetaEl.textContent = `峰值 ${peakKey} · ${money(buckets.get(peakKey) ?? 0)} · ${keys.length} ${daily ? "天" : "个月"}`;
  }

  function renderCats() {
    const list = rangeList();
    const totals = new Map<string, number>();
    for (const entry of list) totals.set(entry.c, (totals.get(entry.c) ?? 0) + entry.a);

    const total = [...totals.values()].reduce((sum, value) => sum + value, 0) || 1;
    const rows = [...totals.entries()].sort((a, b) => b[1] - a[1]);
    const max = rows[0]?.[1] ?? 1;

    catsEl.innerHTML = rows
      .map(([key, amount]) => {
        const meta = CATS[key] ?? { label: key, color: "#98a4b0" };
        const pressed = String(!hidden.has(key));
        return `<button type="button" class="exp-cat" data-cat="${key}" aria-pressed="${pressed}" style="--c:${meta.color}">
          <span class="dot"></span>
          <span class="name">${meta.label}</span>
          <span class="track"><i style="width:${((amount / max) * 100).toFixed(1)}%"></i></span>
          <span class="amt">${money(amount)}</span>
          <span class="pct">${((amount / total) * 100).toFixed(1)}%</span>
        </button>`;
      })
      .join("");

    catMetaEl.textContent = rows.length ? `${rows.length} 个分类 · 合计 ${money(total)}` : "—";
  }

  function renderList() {
    const list = filtered();
    limit = Math.min(limit, Math.max(list.length, PAGE_SIZE));
    const visible = list.slice(0, limit);

    if (!visible.length) {
      listEl.innerHTML = `<p class="exp-empty">这个筛选下还没有记录。</p>`;
      moreBtn.hidden = true;
      return;
    }

    let lastMonth = "";
    const monthTotals = new Map<string, number>();
    for (const entry of list) {
      const month = entry.d.slice(0, 7);
      monthTotals.set(month, (monthTotals.get(month) ?? 0) + entry.a);
    }

    const html = visible
      .map(entry => {
        const month = entry.d.slice(0, 7);
        let header = "";
        if (month !== lastMonth) {
          lastMonth = month;
          header = `<div class="exp-month"><span>${entry.d.slice(0, 4)} 年 ${entry.d.slice(5, 7)} 月</span><b>${money(monthTotals.get(month) ?? 0)}</b></div>`;
        }
        return `${header}<article class="exp-row">${rowHtml(entry)}</article>`;
      })
      .join("");

    listEl.innerHTML = html;
    moreBtn.hidden = limit >= list.length;
  }

  function rowHtml(entry: Entry) {
    const meta = CATS[entry.c] ?? { label: entry.c, color: "#98a4b0" };
    const date = new Date(Number(entry.d.slice(0, 4)), Number(entry.d.slice(5, 7)) - 1, Number(entry.d.slice(8, 10)));
    const note = entry.n ? entry.n.replace(/</g, "&lt;") : "—";
    return `<div class="exp-date">
        <b>${entry.d.slice(5, 7)}-${entry.d.slice(8, 10)}</b>
        <span>周${WEEKDAYS[date.getDay()]}</span>
      </div>
      <span class="exp-tag" style="--c:${meta.color}"><i></i>${meta.label}</span>
      <span class="exp-note" title="${note}">${note}</span>
      <span class="exp-amount">${money(entry.a)}</span>`;
  }

  function renderAll() {
    renderStats();
    renderSummary();
    renderChart();
    renderCats();
    renderList();
  }

  presetsEl.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-preset]");
    if (!button) return;
    applyPreset(button.dataset.preset ?? "month");
  });

  monthEl.addEventListener("change", () => {
    const month = monthEl.value;
    if (month === "all") {
      activePreset = null;
      applyPreset("all");
      return;
    }
    activePreset = month === today.slice(0, 7) ? "month" : null;
    rangeStart = `${month}-01`;
    rangeEnd = monthEnd(month);
    limit = PAGE_SIZE;
    syncInputs();
    renderAll();
  });

  const onDateChange = () => {
    const start = startEl.value || minDate;
    const end = endEl.value || maxDate;
    rangeStart = start <= end ? start : end;
    rangeEnd = start <= end ? end : start;
    activePreset = null;
    limit = PAGE_SIZE;
    syncInputs();
    renderAll();
  };

  startEl.addEventListener("change", onDateChange);
  endEl.addEventListener("change", onDateChange);

  catsEl.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-cat]");
    if (!button) return;
    const key = button.dataset.cat ?? "";
    if (hidden.has(key)) hidden.delete(key);
    else hidden.add(key);
    limit = PAGE_SIZE;
    renderAll();
  });

  moreBtn.addEventListener("click", () => {
    limit += PAGE_SIZE;
    renderList();
  });

  renderMonths();
  applyPreset("month");
</script>
