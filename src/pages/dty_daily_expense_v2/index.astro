---
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Entry = { d: string; a: number; c: string; n: string | null };
type Payload = {
  syncedAt: string;
  stats: {
    total: number;
    count: number;
    months: number;
    start: string | null;
    end: string | null;
    avgMonthly: number;
  };
  entries: Entry[];
};

const dataPath = resolve(process.cwd(), "public/data/daily-expense.json");
const data: Payload = existsSync(dataPath)
  ? JSON.parse(readFileSync(dataPath, "utf8"))
  : {
      syncedAt: "",
      stats: { total: 0, count: 0, months: 0, start: null, end: null, avgMonthly: 0 },
      entries: []
    };

const money = (value: number) =>
  `¥${value.toLocaleString("zh-CN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

const span = data.stats.start && data.stats.end
  ? `${data.stats.start.slice(0, 7)} ~ ${data.stats.end.slice(0, 7)}`
  : "—";

const syncedLabel = data.syncedAt
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    }).format(new Date(data.syncedAt))
  : "—";
---

<BaseLayout title="收支" description="按日期记录的支出账本">
  <section class="container exp-hero">
    <p class="eyebrow">Expense Ledger</p>
    <h1 class="exp-title">收支</h1>
    <p class="lead exp-lead">每一笔花出去的钱，都记在这里。</p>

    <dl class="exp-stats">
      <div>
        <dt>累计支出</dt>
        <dd>{money(data.stats.total)}</dd>
      </div>
      <div>
        <dt>记录笔数</dt>
        <dd>{data.stats.count}<small>笔</small></dd>
      </div>
      <div>
        <dt>月均支出</dt>
        <dd>{money(data.stats.avgMonthly)}</dd>
      </div>
      <div>
        <dt>跨度</dt>
        <dd class="exp-span">{span}<small>{data.stats.months} 个月</small></dd>
      </div>
    </dl>
  </section>

  <section class="container">
    <div class="exp-filter">
      <div class="exp-chips" id="exp-years" role="group" aria-label="按年份筛选"></div>
      <p class="exp-summary" id="exp-summary">—</p>
    </div>
  </section>

  <section class="container exp-panel-wrap">
    <div class="exp-panel">
      <header class="exp-panel-head">
        <div>
          <h2>月度趋势</h2>
          <p class="muted">每个月的支出总额，按年份着色</p>
        </div>
        <span class="exp-meta" id="exp-chart-meta">—</span>
      </header>
      <div class="exp-chart-wrap">
        <div class="exp-chart" id="exp-chart"></div>
      </div>
    </div>
  </section>

  <section class="container exp-panel-wrap">
    <div class="exp-panel">
      <header class="exp-panel-head">
        <div>
          <h2>分类构成</h2>
          <p class="muted">点击分类可隐藏或恢复，趋势图与流水会同步刷新</p>
        </div>
        <span class="exp-meta" id="exp-cat-meta">—</span>
      </header>
      <div class="exp-cats" id="exp-cats"></div>
    </div>
  </section>

  <section class="container">
    <div class="exp-list" id="exp-list">
      <p class="exp-empty">正在载入…</p>
    </div>

    <div class="exp-more">
      <button type="button" id="exp-more" hidden>加载更多</button>
    </div>

    <p class="exp-source">
      数据来源：MySQL 表 <code>dty_daily_expense_v2</code> · 最近同步 {syncedLabel}
    </p>
  </section>
</BaseLayout>

<script type="application/json" id="exp-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

<style is:global>
  .exp-hero {
    padding-bottom: 10px;
  }

  .exp-title {
    font-size: clamp(2.6rem, 9vw, 5rem);
    letter-spacing: -0.02em;
  }

  .exp-lead {
    margin-top: 14px;
  }

  .exp-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin: 26px 0 0;
    padding: 0;
  }

  .exp-stats div {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .exp-stats div::after {
    content: "";
    position: absolute;
    inset: auto -30% -60% auto;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent), transparent 80%), transparent 70%);
  }

  .exp-stats dt {
    color: var(--muted);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
  }

  .exp-stats dd {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.25;
  }

  .exp-stats dd small {
    margin-left: 5px;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .exp-stats .exp-span {
    font-size: 1rem;
    font-weight: 700;
  }

  .exp-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
    margin: 24px 0 18px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .exp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .exp-chips button {
    padding: 6px 15px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .exp-chips button:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .exp-chips button[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--surface-strong);
    font-weight: 700;
  }

  .exp-summary {
    margin: 0 0 0 auto;
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .exp-summary b {
    color: var(--text);
  }

  .exp-panel-wrap {
    margin-bottom: 16px;
  }

  .exp-panel {
    padding: 20px 22px 22px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--accent), transparent 93%), transparent 55%),
      var(--surface);
  }

  .exp-panel-head {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .exp-panel-head h2 {
    margin: 0 0 4px;
    font-size: 1.15rem;
  }

  .exp-panel-head p {
    margin: 0;
    font-size: 0.84rem;
  }

  .exp-meta {
    color: var(--muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .exp-chart-wrap {
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .exp-chart {
    display: flex;
    gap: 6px;
    align-items: flex-end;
    min-height: 156px;
    padding-top: 8px;
  }

  .exp-col {
    display: flex;
    flex: 1 0 24px;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    min-width: 24px;
    height: 148px;
    text-align: center;
  }

  .exp-col-bar {
    width: 100%;
    min-height: 3px;
    border-radius: 5px 5px 2px 2px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--yc), transparent 20%), var(--yc));
    transition: filter 0.15s, height 0.2s;
  }

  .exp-col:hover .exp-col-bar {
    filter: saturate(1.25) brightness(1.06);
  }

  .exp-col-label {
    color: var(--muted);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .exp-col-year {
    color: color-mix(in srgb, var(--muted), transparent 35%);
    font-size: 0.58rem;
    line-height: 1;
  }

  .exp-cats {
    display: grid;
    gap: 4px;
  }

  .exp-cat {
    display: grid;
    grid-template-columns: 10px minmax(84px, 110px) minmax(0, 1fr) 104px 52px;
    gap: 10px;
    align-items: center;
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: none;
    color: var(--text);
    font-size: 0.88rem;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, opacity 0.15s;
  }

  .exp-cat:hover {
    border-color: var(--line);
    background: var(--surface-strong);
  }

  .exp-cat[aria-pressed="false"] {
    opacity: 0.42;
  }

  .exp-cat .dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--c);
  }

  .exp-cat .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .exp-cat .track {
    display: block;
    height: 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--line), transparent 40%);
    overflow: hidden;
  }

  .exp-cat .track i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--c);
  }

  .exp-cat .amt {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .exp-cat .pct {
    color: var(--muted);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .exp-list {
    display: grid;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    overflow: hidden;
  }

  .exp-month {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 11px 20px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface-strong), transparent 25%);
