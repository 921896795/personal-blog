</style>

<script>
  type Entry = { d: string; v: number[]; st: number | null; tt: number | null; s: string | null };

  const META: Record<string, { label: string; color: string }> = {
    work: { label: "工作", color: "var(--fb-work)" },
    read: { label: "阅读", color: "var(--fb-read)" },
    stock_sb: { label: "上班看盘", color: "var(--fb-stock-sb)" },
    stock_xb: { label: "复盘开发", color: "var(--fb-stock-xb)" },
    studyself: { label: "长期自学", color: "var(--fb-self)" },
    study: { label: "学习", color: "var(--fb-study)" },
    account: { label: "做账号", color: "var(--fb-account)" },
    exercise: { label: "运动", color: "var(--fb-exercise)" },
    temp: { label: "临时事项", color: "var(--fb-temp)" },
    other: { label: "其他", color: "var(--fb-other)" }
  };

  const STUDY_TYPES: Record<string, string> = {
    "0": "未分类",
    "1": "视频制作",
    "2": "机器学习",
    "3": "摄影",
    "4": "Python",
    "5": "数分",
    "6": "AI",
    "7": "程序开发",
    "8": "新工作",
    "9": "整理"
  };

  const TEMP_TYPES: Record<string, string> = {
    "0": "未分类",
    "1": "通话",
    "2": "休息",
    "3": "摸鱼",
    "4": "游戏",
    "5": "通话",
    "6": "交流"
  };

  const WEEKDAYS = ["日", "一", "二", "三", "四", "五", "六"];
  const PAGE_SIZE = 60;

  const payloadNode = document.getElementById("fb-data");
  const raw = payloadNode?.textContent ?? "{}";
  const payload = JSON.parse(raw) as {
    categories: string[];
    entries: Entry[];
    stats: { days: number; hours: number; start: string | null; end: string | null };
  };

  const categories = payload.categories;
  const entries = payload.entries;

  const legendEl = document.getElementById("fb-legend") as HTMLElement;
  const stackedEl = document.getElementById("fb-stacked") as HTMLElement;
  const rangeEl = document.getElementById("fb-range") as HTMLElement;
  const presetsEl = document.getElementById("fb-presets") as HTMLElement;
  const monthEl = document.getElementById("fb-month") as HTMLSelectElement;
  const startEl = document.getElementById("fb-start") as HTMLInputElement;
  const endEl = document.getElementById("fb-end") as HTMLInputElement;
  const summaryEl = document.getElementById("fb-range-summary") as HTMLElement;
  const daysEl = document.getElementById("fb-days") as HTMLElement;
  const moreBtn = document.getElementById("fb-more") as HTMLButtonElement;

  const allDates = entries.map(entry => entry.d).sort();
  const minDate = allDates[0] ?? "";
  const maxDate = allDates[allDates.length - 1] ?? "";

  let rangeStart = minDate;
  let rangeEnd = maxDate;
  let activePreset: string | null = "last30";
  let limit = PAGE_SIZE;
  const hidden = new Set<string>();

  const sum = (entry: Entry) => entry.v.reduce((total, hours) => total + hours, 0);
  const fmt = (value: number) => (Math.round(value * 10) / 10).toString().replace(/\.0$/, "");
  const pad = (value: string) => value.padStart(2, "0");

  const toDate = (value: string) => {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(year, month - 1, day);
  };
  const toISO = (date: Date) =>
    `${date.getFullYear()}-${pad(String(date.getMonth() + 1))}-${pad(String(date.getDate()))}`;
  const shiftDays = (value: string, delta: number) => {
    const date = toDate(value);
    date.setDate(date.getDate() + delta);
    return toISO(date);
  };
  const monthEnd = (month: string) => {
    const [year, index] = month.split("-").map(Number);
    return toISO(new Date(year, index, 0));
  };
  // 以周一为一周起点
  const weekStart = (value: string) => shiftDays(value, -((toDate(value).getDay() + 6) % 7));

  function filtered() {
    return entries.filter(entry => entry.d >= rangeStart && entry.d <= rangeEnd);
  }

  function syncInputs() {
    startEl.value = rangeStart;
    endEl.value = rangeEnd;

    const sameMonth = rangeStart.slice(0, 7) === rangeEnd.slice(0, 7);
    const wholeMonth = sameMonth && rangeStart.endsWith("-01") && rangeEnd === monthEnd(rangeStart.slice(0, 7));
    monthEl.value = wholeMonth ? rangeStart.slice(0, 7) : "all";

    presetsEl.querySelectorAll<HTMLButtonElement>("button").forEach(button => {
      button.setAttribute("aria-pressed", String(button.dataset.preset === activePreset));
    });
  }

  function applyPreset(key: string) {
    activePreset = key;

    if (key === "week") {
      rangeStart = weekStart(maxDate);
      rangeEnd = shiftDays(rangeStart, 6);
    } else if (key === "last7") {
      rangeStart = shiftDays(maxDate, -6);
      rangeEnd = maxDate;
    } else if (key === "last30") {
      rangeStart = shiftDays(maxDate, -29);
      rangeEnd = maxDate;
    } else if (key === "month") {
      rangeStart = `${maxDate.slice(0, 7)}-01`;
      rangeEnd = monthEnd(maxDate.slice(0, 7));
    } else if (key === "year") {
      rangeStart = `${maxDate.slice(0, 4)}-01-01`;
      rangeEnd = maxDate;
    } else {
      rangeStart = minDate;
      rangeEnd = maxDate;
    }

    limit = PAGE_SIZE;
    syncInputs();
    renderAll();
  }

  function renderSummary() {
    const list = filtered();
    const hours = list.reduce((total, entry) => total + sum(entry), 0);

    summaryEl.innerHTML = list.length
      ? `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b> · 共 <b>${list.length}</b> 天 · 合计 <b>${fmt(hours)}</b> 小时 · 日均 <b>${(hours / list.length).toFixed(1)}</b> 小时`
      : `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b> · 所选区间没有记录`;
  }

  function renderLegendAndBar() {
    const list = filtered();
    const totals = categories.map((_, index) =>
      list.reduce((total, entry) => total + entry.v[index], 0)
    );
    const grandTotal = totals.reduce((total, hours) => total + hours, 0) || 1;

    stackedEl.innerHTML = categories
      .map((key, index) => {
        if (hidden.has(key) || totals[index] <= 0) return "";
        return `<span class="seg" style="flex:${totals[index]} 1 0;background:${META[key].color}" title="${META[key].label} ${fmt(totals[index])}h"></span>`;
      })
      .join("");

    legendEl.innerHTML = categories
      .map((key, index) => {
        const percentage = (totals[index] / grandTotal) * 100;
        const pressed = String(!hidden.has(key));
        return `<li>
          <button type="button" data-cat="${key}" aria-pressed="${pressed}" style="--c:${META[key].color}">
            <span class="dot"></span>
            <span class="name">${META[key].label}</span>
            <span class="value"><b>${fmt(totals[index])}</b>h · ${percentage.toFixed(1)}%</span>
          </button>
        </li>`;
      })
      .join("");

    const dates = list.map(entry => entry.d).sort();
    rangeEl.textContent = dates.length ? `${dates[0]} — ${dates[dates.length - 1]}` : "暂无数据";
  }

  function renderList() {
    const list = filtered();
    limit = Math.min(limit, Math.max(list.length, PAGE_SIZE));
    const visible = list.slice(0, limit);

    if (!visible.length) {
      daysEl.innerHTML = `<p class="fb-empty">这个筛选下还没有记录。</p>`;
      moreBtn.hidden = true;
      return;
    }

    let lastMonth = "";
    const html = visible
      .map(entry => {
        const month = entry.d.slice(0, 7);
        let header = "";
        if (month !== lastMonth) {
          lastMonth = month;
          header = `<div class="fb-month"><span>${entry.d.slice(0, 4)} 年 ${entry.d.slice(5, 7)} 月</span></div>`;
        }

        const date = new Date(Number(entry.d.slice(0, 4)), Number(entry.d.slice(5, 7)) - 1, Number(entry.d.slice(8, 10)));
        const total = sum(entry);
        // 跨年份区间时日期副标题里带上年份，避免误读
        const showYear = rangeStart.slice(0, 4) !== rangeEnd.slice(0, 4);

        const segments = categories
          .map((key, index) => {
            const hours = entry.v[index];
            if (hidden.has(key) || hours <= 0 || total <= 0) return "";
            return `<span class="seg" style="flex:${hours} 1 0;background:${META[key].color}" title="${META[key].label} ${fmt(hours)}h"></span>`;
          })
          .join("");

        // 以 24 小时为满格，条形长度直接反映当天填满了几小时
        const rest = Math.max(24 - total, 0);
        const restSpan = rest > 0 ? `<span class="rest" style="flex:${rest} 1 0"></span>` : "";

        const tags = categories
          .map((key, index) => {
            const hours = entry.v[index];
            if (hidden.has(key) || hours <= 0) return "";
            let name = META[key].label;
            if (key === "study" && entry.st !== null && STUDY_TYPES[String(entry.st)]) {
              name += ` · ${STUDY_TYPES[String(entry.st)]}`;
            }
            if (key === "temp" && entry.tt !== null && TEMP_TYPES[String(entry.tt)]) {
              name += ` · ${TEMP_TYPES[String(entry.tt)]}`;
            }
            return `<span class="fb-tag" style="--c:${META[key].color}"><i></i>${name} ${fmt(hours)}h</span>`;
          })
          .join("");

        return `${header}
          <article class="fb-day">
            <div class="fb-date">
              <b>${pad(entry.d.slice(5, 7))}-${pad(entry.d.slice(8, 10))}</b>
              <span>${showYear ? entry.d.slice(0, 4) + " · " : ""}周${WEEKDAYS[date.getDay()]}</span>
            </div>
            <div class="fb-main">
              <div class="fb-bar">${segments}${restSpan}</div>
              ${tags ? `<div class="fb-tags">${tags}</div>` : ""}
              ${entry.s ? `<p class="fb-summary">“${entry.s.replace(/</g, "&lt;")}”</p>` : ""}
            </div>
            <div class="fb-total"><b>${fmt(total)}</b>h</div>
          </article>`;
      })
      .join("");

    daysEl.innerHTML = html;
    moreBtn.hidden = limit >= list.length;
  }

  function renderAll() {
    renderSummary();
    renderLegendAndBar();
    renderList();
  }

  function renderMonths() {
    const months = [...new Set(entries.map(entry => entry.d.slice(0, 7)))].sort().reverse();
    monthEl.innerHTML = [
      `<option value="all">全部</option>`,
      ...months.map(month => `<option value="${month}">${month.slice(0, 4)} 年 ${month.slice(5, 7)} 月</option>`)
    ].join("");
  }

  presetsEl.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-preset]");
    if (!button) return;
    applyPreset(button.dataset.preset ?? "last30");
  });

  monthEl.addEventListener("change", () => {
    const month = monthEl.value;
    if (month === "all") {
      activePreset = null;
      applyPreset("all");
      return;
    }
    activePreset = month === maxDate.slice(0, 7) ? "month" : null;
    rangeStart = `${month}-01`;
    rangeEnd = monthEnd(month);
    limit = PAGE_SIZE;
    syncInputs();
    renderAll();
  });

  const onDateChange = () => {
    const start = startEl.value || minDate;
    const end = endEl.value || maxDate;
    rangeStart = start <= end ? start : end;
    rangeEnd = start <= end ? end : start;
    activePreset = null;
    limit = PAGE_SIZE;
    syncInputs();
    renderAll();
  };

  startEl.addEventListener("change", onDateChange);
  endEl.addEventListener("change", onDateChange);

  legendEl.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-cat]");
    if (!button) return;
    const key = button.dataset.cat ?? "";
    if (hidden.has(key)) hidden.delete(key);
    else hidden.add(key);
    renderAll();
  });

  moreBtn.addEventListener("click", () => {
    limit += PAGE_SIZE;
    renderList();
  });

  renderMonths();
  applyPreset("last30");
</script>
