---
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Entry = { d: string; v: number[]; st: number | null; tt: number | null; s: string | null };
type Payload = {
  syncedAt: string;
  categories: string[];
  stats: { days: number; hours: number; start: string | null; end: string | null };
  entries: Entry[];
};

const dataPath = resolve(process.cwd(), "public/data/daily-feedback.json");
const data: Payload = existsSync(dataPath)
  ? JSON.parse(readFileSync(dataPath, "utf8"))
  : {
      syncedAt: "",
      categories: [],
      stats: { days: 0, hours: 0, start: null, end: null },
      entries: []
    };

const fmtHours = (value: number) =>
  value >= 1000 ? Math.round(value).toLocaleString("zh-CN") : value.toFixed(1).replace(/\.0$/, "");

const yearSpan =
  data.stats.start && data.stats.end
    ? data.stats.start.slice(0, 4) === data.stats.end.slice(0, 4)
      ? data.stats.start.slice(0, 4)
      : `${data.stats.start.slice(0, 4)} — ${data.stats.end.slice(0, 4)}`
    : "—";

const dailyAverage = data.stats.days ? data.stats.hours / data.stats.days : 0;

const syncedLabel = data.syncedAt
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    }).format(new Date(data.syncedAt))
  : "—";

const years = [...new Set(data.entries.map(entry => entry.d.slice(0, 4)))].sort().reverse();
---

<BaseLayout title="每日时间" description="每天的时间都去了哪里的可视化账本">
  <section class="container fb-hero">
    <p class="eyebrow">Time Ledger</p>
    <h1 class="fb-title">每日时间</h1>
    <p class="lead fb-lead">把每天拆成小时，看看它们最后都去了哪里。</p>

    <dl class="fb-stats">
      <div>
        <dt>记录天数</dt>
        <dd>{data.stats.days}<small>天</small></dd>
      </div>
      <div>
        <dt>累计投入</dt>
        <dd>{fmtHours(data.stats.hours)}<small>小时</small></dd>
      </div>
      <div>
        <dt>日均</dt>
        <dd>{dailyAverage.toFixed(1)}<small>小时</small></dd>
      </div>
      <div>
        <dt>跨度</dt>
        <dd class="fb-span">{yearSpan}</dd>
      </div>
    </dl>
  </section>

  <section class="container fb-panel-wrap">
    <div class="fb-panel">
      <header class="fb-panel-head">
        <div>
          <h2>时间构成</h2>
          <p class="muted">点击图例可隐藏对应分类，条形会重新计算比例</p>
        </div>
        <span class="fb-range" id="fb-range">—</span>
      </header>

      <div class="fb-stacked" id="fb-stacked" aria-hidden="true"></div>
      <ul class="fb-legend" id="fb-legend"></ul>
    </div>
  </section>

  <section class="container">
    <div class="fb-controls">
      <div class="fb-chips" id="fb-years" role="group" aria-label="按年份筛选"></div>
      <span class="fb-count" id="fb-count"></span>
    </div>

    <div class="fb-days" id="fb-days">
      <p class="fb-empty">正在载入…</p>
    </div>

    <div class="fb-more">
      <button type="button" id="fb-more" hidden>加载更多</button>
    </div>

    <p class="fb-source">数据来源：MySQL 表 <code>dty_daily_feedback</code> · 最近同步 {syncedLabel}</p>
  </section>
</BaseLayout>

<script type="application/json" id="fb-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

<style is:global>
  :root {
    --fb-work: #2f6f73;
    --fb-read: #6f8f66;
    --fb-stock-sb: #c98a4b;
    --fb-stock-xb: #a95f3c;
    --fb-self: #5f7fa8;
    --fb-study: #7d68a6;
    --fb-account: #b36179;
    --fb-exercise: #7f8f4e;
    --fb-temp: #918577;
    --fb-other: #98a4b0;
  }

  :root.dark {
    --fb-work: #4fa3a7;
    --fb-read: #94bd8a;
    --fb-stock-sb: #e0aa6a;
    --fb-stock-xb: #d1804f;
    --fb-self: #8ab0d6;
    --fb-study: #ab97d1;
    --fb-account: #d68aa0;
    --fb-exercise: #a9bd72;
    --fb-temp: #b5a89b;
    --fb-other: #aebac6;
  }

  .fb-hero {
    padding-bottom: 12px;
  }

  .fb-title {
    font-size: clamp(2.6rem, 9vw, 5rem);
    letter-spacing: -0.02em;
  }

  .fb-lead {
    margin-top: 14px;
  }

  .fb-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin: 26px 0 0;
    padding: 0;
  }

  .fb-stats div {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .fb-stats div::after {
    content: "";
    position: absolute;
    inset: auto -30% -60% auto;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent), transparent 78%), transparent 70%);
  }

  .fb-stats dt {
    color: var(--muted);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
  }

  .fb-stats dd {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .fb-stats dd small {
    margin-left: 4px;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .fb-stats .fb-span {
    font-size: 1.05rem;
    font-weight: 700;
  }

  .fb-panel {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background:
