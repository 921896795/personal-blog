    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    margin: 30px 0 16px;
  }

  .fb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .fb-chips button {
    padding: 6px 15px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
