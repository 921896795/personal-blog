  }

  .fb-legend .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
  }

  .fb-legend .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
