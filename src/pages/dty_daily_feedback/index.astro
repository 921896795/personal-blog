  .fb-range {
    color: var(--muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .fb-stacked {
    display: flex;
    gap: 0;
    height: 20px;
    padding: 0;
    border-radius: 999px;
