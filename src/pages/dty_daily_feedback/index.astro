  }

  .fb-date {
    display: grid;
    gap: 1px;
    font-variant-numeric: tabular-nums;
  }

  .fb-date b {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .fb-date span {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .fb-main {
    display: grid;
    gap: 7px;
    min-width: 0;
  }

  .fb-bar {
    display: flex;
    gap: 0;
    height: 11px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--line), transparent 55%);
    overflow: hidden;
  }

  .fb-bar .seg,
  .fb-bar .rest {
    flex-basis: 0;
    min-width: 0;
    height: 100%;
  }

  .fb-bar .seg:first-child {
