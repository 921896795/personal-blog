      var(--surface);
  }

  .fb-panel-head {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .fb-panel-head h2 {
    margin: 0 0 4px;
    font-size: 1.15rem;
  }

