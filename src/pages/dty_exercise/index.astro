---
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Entry = { d: string; t: string; du: number; nu: number; n: string | null };
type Payload = {
  syncedAt: string;
  stats: {
    total: number;
    types: number;
    days: number;
    distance: number;
    duration: number;
    months: number;
    start: string | null;
    end: string | null;
  };
  entries: Entry[];
};

const dataPath = resolve(process.cwd(), "public/data/exercise.json");
const data: Payload = existsSync(dataPath)
  ? JSON.parse(readFileSync(dataPath, "utf8"))
  : {
      syncedAt: "",
      stats: { total: 0, types: 0, days: 0, distance: 0, duration: 0, months: 0, start: null, end: null },
      entries: []
    };

const one = (value: number) =>
  value.toLocaleString("zh-CN", { minimumFractionDigits: 1, maximumFractionDigits: 1 });

// 首屏按默认区间（当前自然月）渲染，与客户端初始筛选一致
const now = new Date();
const currentMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
const initialStart = `${currentMonth}-01`;
const initialEnd = (() => {
  const [year, index] = currentMonth.split("-").map(Number);
  const last = new Date(year, index, 0);
  return `${year}-${String(last.getMonth() + 1).padStart(2, "0")}-${String(last.getDate()).padStart(2, "0")}`;
})();
const initialEntries = data.entries.filter(entry => entry.d >= initialStart && entry.d <= initialEnd);
const initialDistance = initialEntries
  .filter(entry => entry.t === "跑步")
  .reduce((sum, entry) => sum + entry.nu, 0);
const initialDuration = initialEntries.reduce((sum, entry) => sum + entry.du, 0);
const initialSpan = `${currentMonth} ~ ${currentMonth}`;

const syncedLabel = data.syncedAt
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    }).format(new Date(data.syncedAt))
  : "—";
---

<BaseLayout title="运动" description="跑步、游泳与工间操的运动记录">
  <section class="container ex-hero">
    <p class="eyebrow">Movement Log</p>
    <h1 class="ex-title">运动</h1>
    <p class="lead ex-lead">跑过、游过、动过的日子，都在这里。</p>
    <p class="ex-last" id="ex-last">
      最近一次 · <b>{data.stats.end ?? "—"}</b>
    </p>

    <dl class="ex-stats">
      <div>
        <dt>运动次数</dt>
        <dd id="ex-stat-total">{initialEntries.length}<small>次</small></dd>
      </div>
      <div>
        <dt>跑步里程</dt>
        <dd id="ex-stat-distance">{one(initialDistance)}<small>km</small></dd>
      </div>
      <div>
        <dt>游泳时长</dt>
        <dd id="ex-stat-duration">{one(initialDuration)}<small>小时</small></dd>
      </div>
      <div>
        <dt>记录跨度</dt>
        <dd class="ex-span" id="ex-stat-span">{initialSpan}<small>1 个月</small></dd>
      </div>
    </dl>
  </section>

  <section class="container">
    <div class="ex-range-bar">
      <div class="ex-chips" id="ex-presets" role="group" aria-label="时间范围">
        <button type="button" data-preset="week" aria-pressed="false">本周</button>
        <button type="button" data-preset="last7" aria-pressed="false">近 7 天</button>
        <button type="button" data-preset="last30" aria-pressed="false">近 30 天</button>
        <button type="button" data-preset="month" aria-pressed="true">本月</button>
        <button type="button" data-preset="year" aria-pressed="false">本年</button>
        <button type="button" data-preset="all" aria-pressed="false">全部</button>
      </div>

      <div class="ex-pickers">
        <label>
          月份
          <select id="ex-month">
            <option value="all">全部</option>
          </select>
        </label>
        <label>
          起
          <input type="date" id="ex-start" />
        </label>
        <label>
          止
          <input type="date" id="ex-end" />
        </label>
      </div>
    </div>

    <p class="ex-summary" id="ex-summary">—</p>
  </section>

  <section class="container ex-panel-wrap">
    <div class="ex-panel">
      <header class="ex-panel-head">
        <div>
          <h2>运动类型</h2>
          <p class="muted">每种运动的次数、累计量与最近一次</p>
        </div>
        <span class="ex-meta" id="ex-type-meta">—</span>
      </header>
      <div class="ex-types" id="ex-types">
        <p class="ex-empty">正在载入…</p>
      </div>
    </div>
  </section>

  <section class="container ex-panel-wrap">
    <div class="ex-panel">
      <header class="ex-panel-head">
        <div>
          <h2 id="ex-chart-title">月度节奏</h2>
          <p class="muted" id="ex-chart-sub">每个月记录的运动次数，按年份着色</p>
        </div>
        <span class="ex-meta" id="ex-chart-meta">—</span>
      </header>
      <div class="ex-chart-wrap">
        <div class="ex-chart" id="ex-chart"></div>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="ex-timeline" id="ex-timeline">
      <p class="ex-empty">正在载入…</p>
    </div>

    <p class="ex-source">
      数据来源：MySQL 表 <code>dty_exercise</code> · 最近同步 {syncedLabel}
    </p>
  </section>
</BaseLayout>

<script type="application/json" id="ex-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

