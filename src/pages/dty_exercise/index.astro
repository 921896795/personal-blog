<script>
  type Entry = { d: string; t: string; du: number; nu: number; n: string | null };

  const TYPES: Record<string, { color: string; unit: string }> = {
    跑步: { color: "#2f6f73", unit: "km" },
    游泳: { color: "#5f7fa8", unit: "小时" },
    工间操: { color: "#c98a4b", unit: "次" }
  };
  const FALLBACK = { color: "#918577", unit: "次" };
  const YEAR_COLORS = ["#7d8fa6", "#2f6f73", "#c98a4b", "#7d68a6"];
  const WEEKDAYS = ["日", "一", "二", "三", "四", "五", "六"];

  const payload = JSON.parse(document.getElementById("ex-data")?.textContent ?? "{}") as {
    stats: { end: string | null };
    entries: Entry[];
  };

  const entries = payload.entries;
  const lastEl = document.getElementById("ex-last") as HTMLElement;
  const presetsEl = document.getElementById("ex-presets") as HTMLElement;
  const monthEl = document.getElementById("ex-month") as HTMLSelectElement;
  const startEl = document.getElementById("ex-start") as HTMLInputElement;
  const endEl = document.getElementById("ex-end") as HTMLInputElement;
  const summaryEl = document.getElementById("ex-summary") as HTMLElement;
  const statTotalEl = document.getElementById("ex-stat-total") as HTMLElement;
  const statDistanceEl = document.getElementById("ex-stat-distance") as HTMLElement;
  const statDurationEl = document.getElementById("ex-stat-duration") as HTMLElement;
  const statSpanEl = document.getElementById("ex-stat-span") as HTMLElement;
  const typesEl = document.getElementById("ex-types") as HTMLElement;
  const typeMetaEl = document.getElementById("ex-type-meta") as HTMLElement;
  const chartTitleEl = document.getElementById("ex-chart-title") as HTMLElement;
  const chartSubEl = document.getElementById("ex-chart-sub") as HTMLElement;
  const chartEl = document.getElementById("ex-chart") as HTMLElement;
  const chartMetaEl = document.getElementById("ex-chart-meta") as HTMLElement;
  const timelineEl = document.getElementById("ex-timeline") as HTMLElement;

  const metaOf = (type: string) => TYPES[type] ?? FALLBACK;
  const pad = (value: string) => value.padStart(2, "0");
  const toDate = (value: string) => {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(year, month - 1, day);
  };
  const toISO = (date: Date) =>
    `${date.getFullYear()}-${pad(String(date.getMonth() + 1))}-${pad(String(date.getDate()))}`;
  const shiftDays = (value: string, delta: number) => {
    const date = toDate(value);
    date.setDate(date.getDate() + delta);
    return toISO(date);
  };
  const round1 = (value: number) => Math.round(value * 10) / 10;

  const monthEnd = (month: string) => {
    const [year, index] = month.split("-").map(Number);
    return toISO(new Date(year, index, 0));
  };
  const monthCount = (start: string, stop: string) => {
    const [startYear, startMonth] = start.split("-").map(Number);
    const [endYear, endMonth] = stop.split("-").map(Number);
    return Math.max(1, (endYear - startYear) * 12 + (endMonth - startMonth) + 1);
  };
  const weekStart = (value: string) => shiftDays(value, -((toDate(value).getDay() + 6) % 7));
  const today = toISO(new Date());

  const allDates = entries.map(entry => entry.d).sort();
  const minDate = allDates[0] ?? "";
  const maxDate = allDates[allDates.length - 1] ?? "";
  let rangeStart = `${today.slice(0, 7)}-01`;
  let rangeEnd = monthEnd(today.slice(0, 7));
  let activePreset: string | null = "month";

  const rangeEntries = () => entries.filter(entry => entry.d >= rangeStart && entry.d <= rangeEnd);

  // 以时长为主的运动（游泳）用 duration，其余用 number
  const primaryOf = (entry: Entry) => (entry.du > 0 ? entry.du : entry.nu);
  const valueLabel = (entry: Entry) => {
    if (entry.du > 0) return `${entry.du.toFixed(1)} 小时`;
    if (entry.nu > 0) return entry.t === "跑步" ? `${entry.nu.toFixed(1)} km` : `${entry.nu.toFixed(0)} 次`;
    return "—";
  };

  function renderLast() {
    const end = payload.stats.end;
    if (!end) {
      lastEl.innerHTML = `还没有运动记录`;
      return;
    }
    const days = Math.max(0, Math.round((toDate(toISO(new Date())).getTime() - toDate(end).getTime()) / 86400000));
    lastEl.innerHTML = `最近一次 · <b>${end}</b> · <b>${days}</b> 天前`;
  }

  function renderTypes() {
    const ranged = rangeEntries();
    const groups = new Map<string, Entry[]>();
    for (const entry of ranged) {
      const list = groups.get(entry.t) ?? [];
      list.push(entry);
      groups.set(entry.t, list);
    }

    const rows = [...groups.entries()].sort((a, b) => b[1].length - a[1].length);
    if (!rows.length) {
      typesEl.innerHTML = `<p class="ex-empty">暂无数据</p>`;
      typeMetaEl.textContent = "—";
      return;
    }

    typesEl.innerHTML = rows
      .map(([type, list]) => {
        const meta = metaOf(type);
        const total = list.reduce((sum, entry) => sum + primaryOf(entry), 0);
        const avg = total / list.length;
        const share = (list.length / ranged.length) * 100;
        const last = list.map(entry => entry.d).sort().pop() ?? "—";
        const unit = meta.unit;
        const totalText = `${round1(total)} ${unit}`;
        return `<article class="ex-type" style="--c:${meta.color}">
          <div class="ex-type-head">
            <span class="ex-type-name">${type}</span>
            <span class="ex-type-share">${share.toFixed(1)}%</span>
          </div>
          <p class="ex-type-main">${list.length}<small>次</small></p>
          <p class="ex-type-sub">累计 ${totalText} · 场均 ${round1(avg)} ${unit}</p>
          <div class="ex-type-bar"><i style="width:${share.toFixed(1)}%"></i></div>
          <span class="ex-type-foot">最近 ${last}</span>
        </article>`;
      })
      .join("");

    typeMetaEl.textContent = `${rows.length} 种运动 · 共 ${ranged.length} 次`;
  }

  function renderChart() {
    const ranged = rangeEntries();
    const months = [...new Set(ranged.map(entry => entry.d.slice(0, 7)))];
    const daily = months.length <= 1;

    chartTitleEl.textContent = daily ? "每日节奏" : "月度节奏";
    chartSubEl.textContent = daily
      ? "所选区间内每天的运动次数"
      : "每个月的运动次数，按年份着色";

    if (!ranged.length) {
      chartEl.innerHTML = `<p class="ex-empty">暂无数据</p>`;
      chartMetaEl.textContent = "—";
      return;
    }

    const counts = new Map<string, number>();
    const distances = new Map<string, number>();
    const durations = new Map<string, number>();
    for (const entry of ranged) {
      const key = daily ? entry.d : entry.d.slice(0, 7);
      counts.set(key, (counts.get(key) ?? 0) + 1);
      if (entry.t === "跑步") distances.set(key, (distances.get(key) ?? 0) + entry.nu);
      if (entry.du > 0) durations.set(key, (durations.get(key) ?? 0) + entry.du);
    }

    // 单月视图按天铺满区间，多个月份时按月份铺满区间
    const keys: string[] = [];
    if (daily) {
      for (let cursor = rangeStart; cursor <= rangeEnd; cursor = shiftDays(cursor, 1)) keys.push(cursor);
    } else {
      let year = Number(rangeStart.slice(0, 4));
      let month = Number(rangeStart.slice(5, 7));
      const endYear = Number(rangeEnd.slice(0, 4));
      const endMonth = Number(rangeEnd.slice(5, 7));
      while (year < endYear || (year === endYear && month <= endMonth)) {
        keys.push(`${year}-${pad(String(month))}`);
        month += 1;
        if (month > 12) {
          month = 1;
          year += 1;
        }
      }
    }

    const years = [...new Set(keys.map(key => key.slice(0, 4)))].sort();
    const max = Math.max(...keys.map(key => counts.get(key) ?? 0), 1);

    chartEl.innerHTML = keys
      .map((key, index) => {
        const count = counts.get(key) ?? 0;
        const height = count ? Math.max(6, (count / max) * 100) : 0;
        const yearIndex = years.indexOf(key.slice(0, 4));
        const showYear = daily
          ? index === 0
          : index === 0 || key.slice(5, 7) === "01";
        const detail = [
          `${count} 次`,
          distances.get(key) ? `${round1(distances.get(key) ?? 0)} km` : "",
          durations.get(key) ? `${round1(durations.get(key) ?? 0)} 小时` : ""
        ]
          .filter(Boolean)
          .join(" · ");
        return `<div class="ex-col" style="--yc:${YEAR_COLORS[yearIndex % YEAR_COLORS.length]}" title="${key} · ${count ? detail : "无记录"}">
          <div class="ex-col-bar${count ? "" : " is-empty"}" style="height:${height.toFixed(1)}%"></div>
          <span class="ex-col-label">${daily ? key.slice(8, 10) : key.slice(5, 7)}</span>
          <span class="ex-col-year">${showYear ? (daily ? key.slice(0, 7) : key.slice(0, 4)) : ""}</span>
        </div>`;
      })
      .join("");

    const peakKey = keys.reduce((best, key) => ((counts.get(key) ?? 0) > (counts.get(best) ?? 0) ? key : best));
    const peakLabel = daily ? peakKey.slice(5) : peakKey;
    chartMetaEl.textContent = `峰值 ${peakLabel} · ${counts.get(peakKey) ?? 0} 次 · ${keys.length} ${daily ? "天" : "个月"}`;
  }

  function renderTimeline() {
    const ranged = rangeEntries();
    if (!ranged.length) {
      timelineEl.innerHTML = `<p class="ex-empty">所选区间还没有运动记录。</p>`;
      return;
    }

    const groups = new Map<string, Entry[]>();
    for (const entry of ranged) {
      const month = entry.d.slice(0, 7);
      const list = groups.get(month) ?? [];
      list.push(entry);
      groups.set(month, list);
    }

    const months = [...groups.keys()].sort().reverse();
    timelineEl.innerHTML = months
      .map(month => {
        const list = groups.get(month) ?? [];
        const rows = list
          .map(entry => {
            const meta = metaOf(entry.t);
            const date = toDate(entry.d);
            const note = entry.n ? entry.n.replace(/</g, "&lt;") : "—";
            return `<article class="ex-item" style="--c:${meta.color}">
              <div class="ex-date">
                <b>${entry.d.slice(5, 7)}-${entry.d.slice(8, 10)}</b>
                <span>周${WEEKDAYS[date.getDay()]}</span>
              </div>
              <span class="ex-tag" style="--c:${meta.color}"><i></i>${entry.t}</span>
              <span class="ex-note" title="${note}">${note}</span>
              <span class="ex-value">${valueLabel(entry)}</span>
            </article>`;
          })
          .join("");
        return `<div class="ex-month"><span>${month.slice(0, 4)} 年 ${month.slice(5, 7)} 月</span><b>${list.length} 次</b></div>${rows}`;
      })
      .join("");
  }

  function renderStats() {
    const ranged = rangeEntries();
    const distance = ranged.filter(entry => entry.t === "跑步").reduce((sum, entry) => sum + entry.nu, 0);
    const duration = ranged.reduce((sum, entry) => sum + entry.du, 0);
    const months = rangeStart && rangeEnd ? monthCount(rangeStart, rangeEnd) : 0;

    statTotalEl.innerHTML = `${ranged.length}<small>次</small>`;
    statDistanceEl.innerHTML = `${round1(distance).toFixed(1)}<small>km</small>`;
    statDurationEl.innerHTML = `${round1(duration).toFixed(1)}<small>小时</small>`;
    statSpanEl.innerHTML = `${rangeStart ? rangeStart.slice(0, 7) : "—"} ~ ${rangeEnd ? rangeEnd.slice(0, 7) : "—"}<small>${months} 个月</small>`;
  }

  function renderSummary() {
    const ranged = rangeEntries();
    if (!ranged.length) {
      summaryEl.innerHTML = `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b> · 所选区间没有记录`;
      return;
    }

    const distance = ranged.filter(entry => entry.t === "跑步").reduce((sum, entry) => sum + entry.nu, 0);
    const duration = ranged.reduce((sum, entry) => sum + entry.du, 0);
    const parts = [`<b>${rangeStart}</b> ~ <b>${rangeEnd}</b>`, `共 <b>${ranged.length}</b> 次`];
    if (distance) parts.push(`跑步 <b>${round1(distance).toFixed(1)}</b> km`);
    if (duration) parts.push(`游泳 <b>${round1(duration).toFixed(1)}</b> 小时`);
    summaryEl.innerHTML = parts.join(" · ");
  }

  function syncInputs() {
    startEl.value = rangeStart;
    endEl.value = rangeEnd;

    const wholeMonth =
      rangeStart &&
      rangeEnd &&
      rangeStart.slice(0, 7) === rangeEnd.slice(0, 7) &&
      rangeStart.endsWith("-01") &&
      rangeEnd === monthEnd(rangeStart.slice(0, 7));
    monthEl.value = wholeMonth ? rangeStart.slice(0, 7) : "all";

    for (const button of presetsEl.querySelectorAll<HTMLButtonElement>("button")) {
      button.setAttribute("aria-pressed", String(button.dataset.preset === activePreset));
    }
  }

  function renderMonths() {
    const months = [...new Set([...entries.map(entry => entry.d.slice(0, 7)), today.slice(0, 7)])].sort().reverse();
    monthEl.innerHTML =
      `<option value="all">全部</option>` +
      months
        .map(month => `<option value="${month}">${month.slice(0, 4)} 年 ${month.slice(5, 7)} 月</option>`)
        .join("");
  }

  function renderAll() {
    renderStats();
    renderSummary();
    renderTypes();
    renderChart();
    renderTimeline();
  }

  function applyPreset(key: string) {
    activePreset = key;
    if (key === "week") {
      rangeStart = weekStart(today);
      rangeEnd = shiftDays(rangeStart, 6);
    } else if (key === "last7") {
      rangeStart = shiftDays(maxDate, -6);
      rangeEnd = maxDate;
    } else if (key === "last30") {
      rangeStart = shiftDays(maxDate, -29);
      rangeEnd = maxDate;
    } else if (key === "month") {
      rangeStart = `${today.slice(0, 7)}-01`;
      rangeEnd = monthEnd(today.slice(0, 7));
    } else if (key === "year") {
      rangeStart = `${today.slice(0, 4)}-01-01`;
      rangeEnd = today;
    } else {
      rangeStart = minDate;
      rangeEnd = maxDate;
    }

    syncInputs();
    renderAll();
  }

  presetsEl.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-preset]");
    if (button?.dataset.preset) applyPreset(button.dataset.preset);
  });

  monthEl.addEventListener("change", () => {
    const value = monthEl.value;
    if (value === "all") {
      rangeStart = minDate;
      rangeEnd = maxDate;
      activePreset = null;
    } else {
      rangeStart = `${value}-01`;
      rangeEnd = monthEnd(value);
      activePreset = value === today.slice(0, 7) ? "month" : null;
    }
    syncInputs();
    renderAll();
  });

  const onDateChange = () => {
    let start = startEl.value || minDate;
    let stop = endEl.value || maxDate;
    if (start > stop) [start, stop] = [stop, start];
    rangeStart = start;
    rangeEnd = stop;
    activePreset = null;
    syncInputs();
    renderAll();
  };

  startEl.addEventListener("change", onDateChange);
  endEl.addEventListener("change", onDateChange);

  renderLast();
  renderMonths();
  applyPreset("month");
</script>
