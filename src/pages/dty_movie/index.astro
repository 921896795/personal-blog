<script>
  type Entry = { id: number; t: string; ty: string; st: string; d: string };

  const TYPE_COLORS: Record<string, string> = {
    电影: "#2f6f73",
    电视剧: "#5f7fa8"
  };
  const YEAR_COLORS = ["#7d8fa6", "#2f6f73", "#c98a4b", "#7d68a6", "#b36179"];
  const WEEKDAYS = ["日", "一", "二", "三", "四", "五", "六"];
  const PAGE = 60;

  const payload = JSON.parse(document.getElementById("mv-data")?.textContent ?? "{}") as {
    stats: { latest: string | null };
    entries: Entry[];
  };

  const entries = payload.entries;
  const lastEl = document.getElementById("mv-last") as HTMLElement;
  const presetsEl = document.getElementById("mv-presets") as HTMLElement;
  const monthEl = document.getElementById("mv-month") as HTMLSelectElement;
  const startEl = document.getElementById("mv-start") as HTMLInputElement;
  const endEl = document.getElementById("mv-end") as HTMLInputElement;
  const summaryEl = document.getElementById("mv-summary") as HTMLElement;
  const statTotalEl = document.getElementById("mv-stat-total") as HTMLElement;
  const statMovieEl = document.getElementById("mv-stat-movie") as HTMLElement;
  const statTvEl = document.getElementById("mv-stat-tv") as HTMLElement;
  const statSpanEl = document.getElementById("mv-stat-span") as HTMLElement;
  const chartTitleEl = document.getElementById("mv-chart-title") as HTMLElement;
  const chartSubEl = document.getElementById("mv-chart-sub") as HTMLElement;
  const chartEl = document.getElementById("mv-chart") as HTMLElement;
  const chartMetaEl = document.getElementById("mv-chart-meta") as HTMLElement;
  const listEl = document.getElementById("mv-list") as HTMLElement;
  const listMetaEl = document.getElementById("mv-list-meta") as HTMLElement;
  const moreEl = document.getElementById("mv-more") as HTMLButtonElement;

  const pad = (value: string) => value.padStart(2, "0");
  const toDate = (value: string) => {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(year, month - 1, day);
  };
  const toISO = (date: Date) =>
    `${date.getFullYear()}-${pad(String(date.getMonth() + 1))}-${pad(String(date.getDate()))}`;
  const shiftDays = (value: string, delta: number) => {
    const date = toDate(value);
    date.setDate(date.getDate() + delta);
    return toISO(date);
  };
  const monthEnd = (month: string) => {
    const [year, index] = month.split("-").map(Number);
    return toISO(new Date(year, index, 0));
  };
  const monthCount = (start: string, stop: string) => {
    const [startYear, startMonth] = start.split("-").map(Number);
    const [endYear, endMonth] = stop.split("-").map(Number);
    return Math.max(1, (endYear - startYear) * 12 + (endMonth - startMonth) + 1);
  };
  const weekStart = (value: string) => shiftDays(value, -((toDate(value).getDay() + 6) % 7));
  const today = toISO(new Date());

  const allDates = entries.map(entry => entry.d).sort();
  const minDate = allDates[0] ?? "";
  const maxDate = allDates[allDates.length - 1] ?? "";
  let rangeStart = `${today.slice(0, 7)}-01`;
  let rangeEnd = monthEnd(today.slice(0, 7));
  let activePreset: string | null = "month";
  let visible = PAGE;

  const rangeEntries = () => entries.filter(entry => entry.d >= rangeStart && entry.d <= rangeEnd);
  const yearColor = (year: string) => {
    const years = [...new Set(allDates.map(day => day.slice(0, 4)))].sort();
    const index = years.indexOf(year);
    return YEAR_COLORS[(index < 0 ? 0 : index) % YEAR_COLORS.length];
  };
  const typeColor = (type: string) => TYPE_COLORS[type] ?? "#918577";

  function renderLast() {
    lastEl.innerHTML = `最近观看 · <b>${payload.stats.latest ?? "—"}</b>`;
  }

  function renderStats() {
    const ranged = rangeEntries();
    const movies = ranged.filter(entry => entry.ty === "电影").length;
    const tv = ranged.filter(entry => entry.ty === "电视剧").length;
    const months = rangeStart && rangeEnd ? monthCount(rangeStart, rangeEnd) : 0;

    statTotalEl.innerHTML = `${ranged.length}<small>部</small>`;
    statMovieEl.innerHTML = `${movies}<small>部</small>`;
    statTvEl.innerHTML = `${tv}<small>部</small>`;
    statSpanEl.innerHTML = `${rangeStart ? rangeStart.slice(0, 7) : "—"} ~ ${rangeEnd ? rangeEnd.slice(0, 7) : "—"}<small>${months} 个月</small>`;
  }

  function renderSummary() {
    const ranged = rangeEntries();
    if (!ranged.length) {
      summaryEl.innerHTML = `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b> · 所选区间没有观看记录`;
      return;
    }

    const movies = ranged.filter(entry => entry.ty === "电影").length;
    const tv = ranged.filter(entry => entry.ty === "电视剧").length;
    summaryEl.innerHTML = [
      `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b>`,
      `共 <b>${ranged.length}</b> 部`,
      movies ? `电影 <b>${movies}</b>` : "",
      tv ? `电视剧 <b>${tv}</b>` : ""
    ]
      .filter(Boolean)
      .join(" · ");
  }

  function renderChart() {
    const ranged = rangeEntries();
    const daily = monthCount(rangeStart, rangeEnd) <= 1;

    chartTitleEl.textContent = daily ? "每日观看" : "观影节奏";
    chartSubEl.textContent = daily
      ? "所选区间内每天的观看数量，按类型堆叠"
      : "每个月的观看数量，按类型堆叠";

    if (!ranged.length) {
      chartEl.innerHTML = `<p class="mv-empty">暂无数据</p>`;
      chartMetaEl.textContent = "—";
      return;
    }

    const counts = new Map<string, { movie: number; tv: number }>();
    for (const entry of ranged) {
      const key = daily ? entry.d : entry.d.slice(0, 7);
      const bucket = counts.get(key) ?? { movie: 0, tv: 0 };
      if (entry.ty === "电视剧") bucket.tv += 1;
      else bucket.movie += 1;
      counts.set(key, bucket);
    }

    const keys: string[] = [];
    if (daily) {
      for (let cursor = rangeStart; cursor <= rangeEnd; cursor = shiftDays(cursor, 1)) keys.push(cursor);
    } else {
      let year = Number(rangeStart.slice(0, 4));
      let month = Number(rangeStart.slice(5, 7));
      const endYear = Number(rangeEnd.slice(0, 4));
      const endMonth = Number(rangeEnd.slice(5, 7));
      while (year < endYear || (year === endYear && month <= endMonth)) {
        keys.push(`${year}-${pad(String(month))}`);
        month += 1;
        if (month > 12) {
          month = 1;
          year += 1;
        }
      }
    }

    const totals = keys.map(key => {
      const bucket = counts.get(key);
      return bucket ? bucket.movie + bucket.tv : 0;
    });
    const max = Math.max(...totals, 1);

    chartEl.innerHTML = keys
      .map((key, index) => {
        const bucket = counts.get(key) ?? { movie: 0, tv: 0 };
        const total = bucket.movie + bucket.tv;
        const height = total ? Math.max(6, (total / max) * 100) : 0;
        const showYear = daily ? index === 0 : index === 0 || key.slice(5, 7) === "01";
        const color = yearColor(key.slice(0, 4));
        const segments = total
          ? `<i class="mv-seg mv-seg-movie" style="flex:${bucket.movie}"></i><i class="mv-seg mv-seg-tv" style="flex:${bucket.tv}"></i>`
          : "";
        return `<div class="mv-col" style="--yc:${color}" title="${key} · ${total} 部${total ? ` · 电影 ${bucket.movie} · 电视剧 ${bucket.tv}` : ""}">
          <div class="mv-col-bar${total ? "" : " is-empty"}" style="height:${height.toFixed(1)}%">${segments}</div>
          <span class="mv-col-label">${daily ? key.slice(8, 10) : key.slice(5, 7)}</span>
          <span class="mv-col-year">${showYear ? (daily ? key.slice(0, 7) : key.slice(0, 4)) : ""}</span>
        </div>`;
      })
      .join("");

    let peakIndex = 0;
    totals.forEach((value, index) => {
      if (value > totals[peakIndex]) peakIndex = index;
    });
    const peakKey = keys[peakIndex] ?? "";
    chartMetaEl.textContent = `峰值 ${daily ? peakKey.slice(5) : peakKey} · ${totals[peakIndex] ?? 0} 部 · ${keys.length} ${daily ? "天" : "个月"}`;
  }

  function renderList() {
    const ranged = rangeEntries();
    if (!ranged.length) {
      listEl.innerHTML = `<p class="mv-empty">所选区间还没有观看记录。</p>`;
      listMetaEl.textContent = "—";
      moreEl.hidden = true;
      return;
    }

    const groups = new Map<string, Entry[]>();
    for (const entry of ranged) {
      const month = entry.d.slice(0, 7);
      const list = groups.get(month) ?? [];
      list.push(entry);
      groups.set(month, list);
    }

    const months = [...groups.keys()].sort().reverse();
    const parts: string[] = [];
    let remaining = visible;

    for (const month of months) {
      if (remaining <= 0) break;
      const list = groups.get(month) ?? [];
      const shown = list.slice(0, remaining);
      remaining -= shown.length;

      const rows = shown
        .map(entry => {
          const date = toDate(entry.d);
          return `<article class="mv-item" style="--c:${typeColor(entry.ty)}">
            <span class="mv-date">
              <b>${entry.d.slice(5, 7)}-${entry.d.slice(8, 10)}</b>
              <span>周${WEEKDAYS[date.getDay()]}</span>
            </span>
            <span class="mv-tag" style="--c:${typeColor(entry.ty)}">${entry.ty}</span>
            <h3 class="mv-name" title="${entry.t.replace(/</g, "&lt;")}">${entry.t.replace(/</g, "&lt;")}</h3>
            <span class="mv-status">${entry.st}</span>
          </article>`;
        })
        .join("");

      parts.push(`<div class="mv-month"><span>${month.slice(0, 4)} 年 ${month.slice(5, 7)} 月</span><b>${list.length} 部</b></div>${rows}`);
    }

    listEl.innerHTML = parts.join("");
    const shownCount = Math.min(visible, ranged.length);
    listMetaEl.textContent = `显示 ${shownCount} / ${ranged.length} 部 · ${months.length} 个月`;
    moreEl.hidden = shownCount >= ranged.length;
  }

  function syncInputs() {
    startEl.value = rangeStart;
    endEl.value = rangeEnd;

    const wholeMonth =
      rangeStart &&
      rangeEnd &&
      rangeStart.slice(0, 7) === rangeEnd.slice(0, 7) &&
      rangeStart.endsWith("-01") &&
      rangeEnd === monthEnd(rangeStart.slice(0, 7));
    monthEl.value = wholeMonth ? rangeStart.slice(0, 7) : "all";

    for (const button of presetsEl.querySelectorAll<HTMLButtonElement>("button")) {
      button.setAttribute("aria-pressed", String(button.dataset.preset === activePreset));
    }
  }

  function renderMonths() {
    const months = [...new Set([...entries.map(entry => entry.d.slice(0, 7)), today.slice(0, 7)])].sort().reverse();
    monthEl.innerHTML =
      `<option value="all">全部</option>` +
      months
        .map(month => `<option value="${month}">${month.slice(0, 4)} 年 ${month.slice(5, 7)} 月</option>`)
        .join("");
  }

  function renderAll() {
    visible = PAGE;
    renderStats();
    renderSummary();
    renderChart();
    renderList();
  }

  function applyPreset(key: string) {
    activePreset = key;
    if (key === "week") {
      rangeStart = weekStart(today);
      rangeEnd = shiftDays(rangeStart, 6);
    } else if (key === "last7") {
      rangeStart = shiftDays(maxDate, -6);
      rangeEnd = maxDate;
    } else if (key === "last30") {
      rangeStart = shiftDays(maxDate, -29);
      rangeEnd = maxDate;
    } else if (key === "month") {
      rangeStart = `${today.slice(0, 7)}-01`;
      rangeEnd = monthEnd(today.slice(0, 7));
    } else if (key === "year") {
      rangeStart = `${today.slice(0, 4)}-01-01`;
      rangeEnd = today;
    } else {
      rangeStart = minDate;
      rangeEnd = maxDate;
    }

    syncInputs();
    renderAll();
  }

  presetsEl.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-preset]");
    if (button?.dataset.preset) applyPreset(button.dataset.preset);
  });

  monthEl.addEventListener("change", () => {
    const value = monthEl.value;
    if (value === "all") {
      rangeStart = minDate;
      rangeEnd = maxDate;
      activePreset = null;
    } else {
      rangeStart = `${value}-01`;
      rangeEnd = monthEnd(value);
      activePreset = value === today.slice(0, 7) ? "month" : null;
    }
    syncInputs();
    renderAll();
  });

  const onDateChange = () => {
    let start = startEl.value || minDate;
    let stop = endEl.value || maxDate;
    if (start > stop) [start, stop] = [stop, start];
    rangeStart = start;
    rangeEnd = stop;
    activePreset = null;
    syncInputs();
    renderAll();
  };

  startEl.addEventListener("change", onDateChange);
  endEl.addEventListener("change", onDateChange);

  moreEl.addEventListener("click", () => {
    visible += PAGE;
    renderList();
  });

  renderLast();
  renderMonths();
  applyPreset("month");
</script>
