---
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Entry = { id: number; t: string; ty: string; st: string; d: string };
type Payload = {
  syncedAt: string;
  stats: {
    total: number;
    movies: number;
    tv: number;
    months: number;
    start: string | null;
    end: string | null;
    latest: string | null;
  };
  entries: Entry[];
};

const dataPath = resolve(process.cwd(), "public/data/movies.json");
const data: Payload = existsSync(dataPath)
  ? JSON.parse(readFileSync(dataPath, "utf8"))
  : {
      syncedAt: "",
      stats: { total: 0, movies: 0, tv: 0, months: 0, start: null, end: null, latest: null },
      entries: []
    };

// 首屏按默认区间（当前自然月）渲染，与客户端初始筛选一致
const now = new Date();
const currentMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
const initialStart = `${currentMonth}-01`;
const initialEnd = (() => {
  const [year, index] = currentMonth.split("-").map(Number);
  const last = new Date(year, index, 0);
  return `${year}-${String(last.getMonth() + 1).padStart(2, "0")}-${String(last.getDate()).padStart(2, "0")}`;
})();
const initialEntries = data.entries.filter(entry => entry.d >= initialStart && entry.d <= initialEnd);
const initialSpan = `${currentMonth} ~ ${currentMonth}`;

const syncedLabel = data.syncedAt
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    }).format(new Date(data.syncedAt))
  : "—";
---

<BaseLayout title="影视" description="按观看时间记录的电影与电视剧">
  <section class="container mv-hero">
    <p class="eyebrow">Screen Log</p>
    <h1 class="mv-title">影视</h1>
    <p class="lead mv-lead">看过的电影和电视剧，一部一部攒起来。</p>
    <p class="mv-last" id="mv-last">
      最近观看 · <b>{data.stats.latest ?? "—"}</b>
    </p>

    <dl class="mv-stats">
      <div>
        <dt>观看总数</dt>
        <dd id="mv-stat-total">{initialEntries.length}<small>部</small></dd>
      </div>
      <div>
        <dt>电影</dt>
        <dd id="mv-stat-movie">{initialEntries.filter(entry => entry.ty === "电影").length}<small>部</small></dd>
      </div>
      <div>
        <dt>电视剧</dt>
        <dd id="mv-stat-tv">{initialEntries.filter(entry => entry.ty === "电视剧").length}<small>部</small></dd>
      </div>
      <div>
        <dt>记录跨度</dt>
        <dd class="mv-span" id="mv-stat-span">{initialSpan}<small>1 个月</small></dd>
      </div>
    </dl>
  </section>

  <section class="container">
    <div class="mv-range-bar">
      <div class="mv-chips" id="mv-presets" role="group" aria-label="时间范围">
        <button type="button" data-preset="week" aria-pressed="false">本周</button>
        <button type="button" data-preset="last7" aria-pressed="false">近 7 天</button>
        <button type="button" data-preset="last30" aria-pressed="false">近 30 天</button>
        <button type="button" data-preset="month" aria-pressed="true">本月</button>
        <button type="button" data-preset="year" aria-pressed="false">本年</button>
        <button type="button" data-preset="all" aria-pressed="false">全部</button>
      </div>

      <div class="mv-pickers">
        <label>
          月份
          <select id="mv-month">
            <option value="all">全部</option>
          </select>
        </label>
        <label>
          起
          <input type="date" id="mv-start" />
        </label>
        <label>
          止
          <input type="date" id="mv-end" />
        </label>
      </div>
    </div>

    <p class="mv-summary" id="mv-summary">—</p>
  </section>

  <section class="container mv-panel-wrap">
    <div class="mv-panel">
      <header class="mv-panel-head">
        <div>
          <h2 id="mv-chart-title">观影节奏</h2>
          <p class="muted" id="mv-chart-sub">每个月的观看数量，按类型堆叠</p>
        </div>
        <div class="mv-aside">
          <span class="mv-legend"><i class="mv-dot mv-dot-movie"></i>电影<i class="mv-dot mv-dot-tv"></i>电视剧</span>
          <span class="mv-meta" id="mv-chart-meta">—</span>
        </div>
      </header>
      <div class="mv-chart-wrap">
        <div class="mv-chart" id="mv-chart"></div>
      </div>
    </div>
  </section>

  <section class="container mv-panel-wrap">
    <div class="mv-panel">
      <header class="mv-panel-head">
        <div>
          <h2>观影记录</h2>
          <p class="muted">按观看月份分组，左侧色条区分类型</p>
        </div>
        <span class="mv-meta" id="mv-list-meta">—</span>
      </header>
      <div class="mv-list" id="mv-list">
        <p class="mv-empty">正在载入…</p>
      </div>
      <div class="mv-more">
        <button type="button" id="mv-more" hidden>加载更多</button>
      </div>
    </div>
  </section>

  <section class="container">
    <p class="mv-source">
      数据来源：MySQL 表 <code>dty_movies</code> · 最近同步 {syncedLabel}
    </p>
  </section>
</BaseLayout>

<script type="application/json" id="mv-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

