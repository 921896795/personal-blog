</style>

<script>
  type Entry = { id: number; w: string; a: string; v: number; n: string | null };

  const PALETTE = ["#2f6f73", "#5f7fa8", "#c98a4b", "#7d68a6", "#b36179", "#4f8a5b"];

  const payload = JSON.parse(document.getElementById("wk-data")?.textContent ?? "{}") as {
    demo: boolean;
    stats: { end: string | null };
    entries: Entry[];
  };

  const entries = payload.entries;
  const lastEl = document.getElementById("wk-last") as HTMLElement;
  const presetsEl = document.getElementById("wk-presets") as HTMLElement;
  const monthEl = document.getElementById("wk-month") as HTMLSelectElement;
  const startEl = document.getElementById("wk-start") as HTMLInputElement;
  const endEl = document.getElementById("wk-end") as HTMLInputElement;
  const summaryEl = document.getElementById("wk-summary") as HTMLElement;
  const statTotalEl = document.getElementById("wk-stat-total") as HTMLElement;
  const statAccountsEl = document.getElementById("wk-stat-accounts") as HTMLElement;
  const statAmountEl = document.getElementById("wk-stat-amount") as HTMLElement;
  const statAvgEl = document.getElementById("wk-stat-avg") as HTMLElement;
  const legendEl = document.getElementById("wk-legend") as HTMLElement;
  const chartEl = document.getElementById("wk-chart") as HTMLElement;
  const chartMetaEl = document.getElementById("wk-chart-meta") as HTMLElement;
  const acctsEl = document.getElementById("wk-accts") as HTMLElement;
  const acctMetaEl = document.getElementById("wk-acct-meta") as HTMLElement;
  const listEl = document.getElementById("wk-list") as HTMLElement;
  const listMetaEl = document.getElementById("wk-list-meta") as HTMLElement;

  const pad = (value: string) => value.padStart(2, "0");
  const toDate = (value: string) => {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(year, month - 1, day);
  };
  const toISO = (date: Date) =>
    `${date.getFullYear()}-${pad(String(date.getMonth() + 1))}-${pad(String(date.getDate()))}`;
  const shiftDays = (value: string, delta: number) => {
    const date = toDate(value);
    date.setDate(date.getDate() + delta);
    return toISO(date);
  };
  const monthEnd = (month: string) => {
    const [year, index] = month.split("-").map(Number);
    return toISO(new Date(year, index, 0));
  };
  const weekStart = (value: string) => shiftDays(value, -((toDate(value).getDay() + 6) % 7));
  const today = toISO(new Date());

  const accountNames = [...new Set(entries.map(entry => entry.a))].sort();
  const accountColor = (name: string) => {
    const index = accountNames.indexOf(name);
    return PALETTE[(index < 0 ? 0 : index) % PALETTE.length];
  };
  const money = (value: number | null) => {
    if (value === null) return "—";
    const abs = Math.abs(value).toLocaleString("zh-CN", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
    if (value === 0) return `¥${abs}`;
    return `${value < 0 ? "-" : "+"}¥${abs}`;
  };
  const esc = (value: string) =>
    value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");

  const allDates = entries.map(entry => entry.w).sort();
  const minDate = allDates[0] ?? "";
  const maxDate = allDates[allDates.length - 1] ?? "";
  const defaultPreset = payload.demo ? "all" : "month";
  let rangeStart = `${today.slice(0, 7)}-01`;
  let rangeEnd = monthEnd(today.slice(0, 7));
  let activePreset: string | null = defaultPreset;

  const rangeEntries = () => entries.filter(entry => entry.w >= rangeStart && entry.w <= rangeEnd);
  const uniqueWeeks = (list: Entry[]) => new Set(list.map(entry => entry.w)).size;

  function renderLast() {
    lastEl.innerHTML = `最近一周 · <b>${payload.stats.end ?? "—"}</b>`;
  }

  function renderStats() {
    const ranged = rangeEntries();
    const weeks = uniqueWeeks(ranged);
    const total = ranged.reduce((sum, entry) => sum + entry.v, 0);
    const accounts = new Set(ranged.map(entry => entry.a)).size;

    statTotalEl.innerHTML = `${ranged.length}<small>条</small>`;
    statAccountsEl.innerHTML = `${accounts}<small>个</small>`;
    statAmountEl.textContent = money(total);
    statAvgEl.innerHTML = `${weeks ? money(total / weeks) : "—"}<small>每周</small>`;
  }

  function renderSummary() {
    const ranged = rangeEntries();
    if (!ranged.length) {
      summaryEl.innerHTML = `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b> · 所选区间没有周度记录`;
      return;
    }

    const weeks = uniqueWeeks(ranged);
    const total = ranged.reduce((sum, entry) => sum + entry.v, 0);
    const accounts = new Set(ranged.map(entry => entry.a)).size;

    summaryEl.innerHTML = [
      `<b>${rangeStart}</b> ~ <b>${rangeEnd}</b>`,
      `共 <b>${ranged.length}</b> 条`,
      `账户 <b>${accounts}</b> 个`,
      `合计 <b>${money(total)}</b>`,
      `周均 <b>${money(total / weeks)}</b>`
    ].join(" · ");
  }

  function renderLegend() {
    const names = [...new Set(rangeEntries().map(entry => entry.a))].sort();
    legendEl.innerHTML = names
      .map(name => `<span><i class="wk-dot" style="--c:${accountColor(name)}"></i>${esc(name)}</span>`)
      .join("");
  }

  function renderChart() {
    const ranged = rangeEntries();
    if (!ranged.length) {
      chartEl.innerHTML = `<p class="wk-empty">暂无数据</p>`;
      chartMetaEl.textContent = "—";
      return;
    }

    const buckets = new Map<string, Map<string, number>>();
    for (const entry of ranged) {
      const week = weekStart(entry.w);
      const bucket = buckets.get(week) ?? new Map<string, number>();
      bucket.set(entry.a, (bucket.get(entry.a) ?? 0) + entry.v);
      buckets.set(week, bucket);
    }

    const keys: string[] = [];
    for (let cursor = weekStart(rangeStart); cursor <= rangeEnd; cursor = shiftDays(cursor, 7)) {
      keys.push(cursor);
    }

    let maxAbs = 1;
    for (const bucket of buckets.values()) {
      for (const value of bucket.values()) maxAbs = Math.max(maxAbs, Math.abs(value));
    }

    const weeklyTotals = keys.map(key => {
      const bucket = buckets.get(key);
      return bucket ? [...bucket.values()].reduce((sum, value) => sum + value, 0) : 0;
    });

    chartEl.innerHTML = keys
      .map((key, index) => {
        const bucket = buckets.get(key) ?? new Map<string, number>();
        const showYear = index === 0 || key.slice(5, 7) === "01";
        const slots = accountNames
          .map(name => {
            const value = bucket.get(name);
            if (value === undefined) return `<span class="wk-slot"></span>`;
            const color = accountColor(name);
            if (value === 0) {
              return `<span class="wk-slot" title="${key} · ${esc(name)} ¥0.00"><i class="wk-bar is-zero" style="background:${color}"></i></span>`;
            }
            const height = Math.max(4, (Math.abs(value) / maxAbs) * 46);
            const tone = value > 0 ? "is-pos" : "is-neg";
            return `<span class="wk-slot" title="${key} · ${esc(name)} ${money(value)}"><i class="wk-bar ${tone}" style="height:${height.toFixed(1)}%;background:${color}"></i></span>`;
          })
          .join("");

        return `<div class="wk-col" title="${key} 当周合计 ${money(weeklyTotals[index])}">
          <div class="wk-col-body"><div class="wk-bars">${slots}</div></div>
          <span class="wk-col-label">${key.slice(5)}</span>
          <span class="wk-col-year">${showYear ? key.slice(0, 4) : ""}</span>
        </div>`;
      })
      .join("");

    let bestIndex = 0;
    let worstIndex = 0;
    weeklyTotals.forEach((value, index) => {
      if (value > weeklyTotals[bestIndex]) bestIndex = index;
      if (value < weeklyTotals[worstIndex]) worstIndex = index;
    });

    const parts = [`最佳 ${keys[bestIndex].slice(5)} ${money(weeklyTotals[bestIndex])}`];
    if (worstIndex !== bestIndex) {
      parts.push(`最差 ${keys[worstIndex].slice(5)} ${money(weeklyTotals[worstIndex])}`);
    }
    parts.push(`${keys.length} 周`);
    chartMetaEl.textContent = parts.join(" · ");
  }

  function renderAccounts() {
    const ranged = rangeEntries();
    if (!ranged.length) {
      acctsEl.innerHTML = `<p class="wk-empty">暂无数据</p>`;
      acctMetaEl.textContent = "—";
      return;
    }

    const groups = new Map<string, Entry[]>();
    for (const entry of ranged) {
      const bucket = groups.get(entry.a) ?? [];
      bucket.push(entry);
      groups.set(entry.a, bucket);
    }

    const rows = [...groups.entries()]
      .map(([name, items]) => ({
        name,
        total: items.reduce((sum, entry) => sum + entry.v, 0),
        weeks: uniqueWeeks(items),
        count: items.length
      }))
      .sort((a, b) => Math.abs(b.total) - Math.abs(a.total));

    const max = Math.abs(rows[0]?.total ?? 0) || 1;

    acctsEl.innerHTML = rows
      .map(row => {
        const width = Math.max(4, (Math.abs(row.total) / max) * 100);
        return `<div class="wk-acct">
          <span class="wk-acct-name" title="${esc(row.name)}"><i style="--c:${accountColor(row.name)}"></i>${esc(row.name)}</span>
          <span class="wk-acct-track"><i style="width:${width.toFixed(1)}%;--c:${accountColor(row.name)}"></i></span>
          <span class="wk-acct-stat"><b>${money(row.total)}</b>${row.weeks} 周 · 周均 ${money(row.total / row.weeks)}</span>
        </div>`;
      })
      .join("");

    acctMetaEl.textContent = `${rows.length} 个账户 · ${uniqueWeeks(ranged)} 周`;
  }

  function renderList() {
    const ranged = rangeEntries();
    if (!ranged.length) {
      listEl.innerHTML = `<p class="wk-empty">所选区间还没有周度记录。</p>`;
      listMetaEl.textContent = "—";
      return;
    }

    const groups = new Map<string, Entry[]>();
    for (const entry of ranged) {
      const week = weekStart(entry.w);
      const bucket = groups.get(week) ?? [];
      bucket.push(entry);
      groups.set(week, bucket);
    }

    const weeks = [...groups.keys()].sort().reverse();
    const parts: string[] = [];

    for (const week of weeks) {
      const items = (groups.get(week) ?? []).slice().sort((a, b) => a.a.localeCompare(b.a, "zh-CN"));
      const total = items.reduce((sum, entry) => sum + entry.v, 0);
      const rows = items
        .map(entry => {
          const tone = entry.v > 0 ? "is-up" : entry.v < 0 ? "is-down" : "";
          return `<div class="wk-row">
            <span class="wk-row-account"><i style="--c:${accountColor(entry.a)}"></i>${esc(entry.a)}</span>
            <span class="wk-row-amount ${tone}">${money(entry.v)}</span>
            <span class="wk-row-note">${entry.n ? esc(entry.n) : "—"}</span>
          </div>`;
        })
        .join("");

      parts.push(
        `<div class="wk-week"><span>${week} ~ ${shiftDays(week, 6).slice(5)}</span><b>合计 ${money(total)}</b></div>${rows}`
      );
    }

    listEl.innerHTML = parts.join("");
    listMetaEl.textContent = `${ranged.length} 条 · ${weeks.length} 周`;
  }

  function syncInputs() {
    startEl.value = rangeStart;
    endEl.value = rangeEnd;

    const wholeMonth =
      rangeStart &&
      rangeEnd &&
      rangeStart.slice(0, 7) === rangeEnd.slice(0, 7) &&
      rangeStart.endsWith("-01") &&
      rangeEnd === monthEnd(rangeStart.slice(0, 7));
    monthEl.value = wholeMonth ? rangeStart.slice(0, 7) : "all";

    for (const button of presetsEl.querySelectorAll<HTMLButtonElement>("button")) {
      button.setAttribute("aria-pressed", String(button.dataset.preset === activePreset));
    }
  }

  function renderMonths() {
    const months = [...new Set([...entries.map(entry => weekStart(entry.w).slice(0, 7)), today.slice(0, 7)])]
      .sort()
      .reverse();
    monthEl.innerHTML =
      `<option value="all">全部</option>` +
      months
        .map(month => `<option value="${month}">${month.slice(0, 4)} 年 ${month.slice(5, 7)} 月</option>`)
        .join("");
  }

  function renderAll() {
    renderStats();
    renderSummary();
    renderLegend();
    renderChart();
    renderAccounts();
    renderList();
  }

  function applyPreset(key: string) {
    activePreset = key;
    if (key === "week") {
      rangeStart = weekStart(today);
      rangeEnd = shiftDays(rangeStart, 6);
    } else if (key === "last7") {
      rangeStart = shiftDays(maxDate, -6);
      rangeEnd = maxDate;
    } else if (key === "last30") {
      rangeStart = shiftDays(maxDate, -29);
      rangeEnd = maxDate;
    } else if (key === "month") {
      rangeStart = `${today.slice(0, 7)}-01`;
      rangeEnd = monthEnd(today.slice(0, 7));
    } else if (key === "year") {
      rangeStart = `${today.slice(0, 4)}-01-01`;
      rangeEnd = today;
    } else {
      rangeStart = minDate;
      rangeEnd = maxDate;
    }

    syncInputs();
    renderAll();
  }

  presetsEl.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-preset]");
    if (button?.dataset.preset) applyPreset(button.dataset.preset);
  });

  monthEl.addEventListener("change", () => {
    const value = monthEl.value;
    if (value === "all") {
      rangeStart = minDate;
      rangeEnd = maxDate;
      activePreset = null;
    } else {
      rangeStart = `${value}-01`;
      rangeEnd = monthEnd(value);
      activePreset = value === today.slice(0, 7) ? "month" : null;
    }
    syncInputs();
    renderAll();
  });

  const onDateChange = () => {
    let start = startEl.value || minDate;
    let stop = endEl.value || maxDate;
    if (start > stop) [start, stop] = [stop, start];
    rangeStart = start;
    rangeEnd = stop;
    activePreset = null;
    syncInputs();
    renderAll();
  };

  startEl.addEventListener("change", onDateChange);
  endEl.addEventListener("change", onDateChange);

  renderLast();
  renderMonths();
  applyPreset(defaultPreset);
</script>
