---
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Entry = { id: number; w: string; a: string; v: number; n: string | null };
type Payload = {
  syncedAt: string;
  demo: boolean;
  stats: {
    total: number;
    accounts: number;
    weeks: number;
    amount: number;
    start: string | null;
    end: string | null;
  };
  entries: Entry[];
};

const dataPath = resolve(process.cwd(), "public/data/week-return.json");
const data: Payload = existsSync(dataPath)
  ? JSON.parse(readFileSync(dataPath, "utf8"))
  : {
      syncedAt: "",
      demo: false,
      stats: { total: 0, accounts: 0, weeks: 0, amount: 0, start: null, end: null },
      entries: []
    };

const money = (value: number) => {
  const abs = Math.abs(value).toLocaleString("zh-CN", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  });
  if (value === 0) return `¥${abs}`;
  return `${value < 0 ? "-" : "+"}¥${abs}`;
};

// 首屏区间：演示数据看全部，真实数据看当前自然月（与支出页一致）
const now = new Date();
const currentMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
const monthLast = (() => {
  const [year, index] = currentMonth.split("-").map(Number);
  const last = new Date(year, index, 0);
  return `${year}-${String(last.getMonth() + 1).padStart(2, "0")}-${String(last.getDate()).padStart(2, "0")}`;
})();
const initialStart = data.demo ? (data.stats.start ?? "") : `${currentMonth}-01`;
const initialEnd = data.demo ? (data.stats.end ?? "") : monthLast;
const initialEntries = data.entries.filter(entry => entry.w >= initialStart && entry.w <= initialEnd);
const initialWeeks = new Set(initialEntries.map(entry => entry.w)).size;
const initialTotal = initialEntries.reduce((sum, entry) => sum + entry.v, 0);
const initialAvg = initialWeeks ? initialTotal / initialWeeks : null;

const syncedLabel = data.syncedAt
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    }).format(new Date(data.syncedAt))
  : "—";
---

<BaseLayout title="周收益" description="按周与账户记录的收益变化">
  <section class="container wk-hero">
    <p class="eyebrow">Weekly Return</p>
    <h1 class="wk-title">周收益</h1>
    <p class="lead wk-lead">按周记录每个账户的金额变化，看清一周的得失。</p>
    <p class="wk-last" id="wk-last">
      最近一周 · <b>{data.stats.end ?? "—"}</b>
    </p>

    <dl class="wk-stats">
      <div>
        <dt>记录笔数</dt>
        <dd id="wk-stat-total">{initialEntries.length}<small>条</small></dd>
      </div>
      <div>
        <dt>账户数</dt>
        <dd id="wk-stat-accounts">{new Set(initialEntries.map(entry => entry.a)).size}<small>个</small></dd>
      </div>
      <div>
        <dt>区间合计</dt>
        <dd id="wk-stat-amount">{money(initialTotal)}</dd>
      </div>
      <div>
        <dt>周均金额</dt>
        <dd id="wk-stat-avg">{initialAvg === null ? "—" : money(initialAvg)}<small>每周</small></dd>
      </div>
    </dl>

    {data.demo && (
      <p class="wk-demo" id="wk-demo">
        当前为演示数据 · {data.stats.total} 条 · {data.stats.start} ~ {data.stats.end}
        ，写入真实数据后自动替换
      </p>
    )}
  </section>

  <section class="container">
    <div class="wk-range-bar">
      <div class="wk-chips" id="wk-presets" role="group" aria-label="时间范围">
        <button type="button" data-preset="week" aria-pressed="false">本周</button>
        <button type="button" data-preset="last7" aria-pressed="false">近 7 天</button>
        <button type="button" data-preset="last30" aria-pressed="false">近 30 天</button>
        <button type="button" data-preset="month" aria-pressed={data.demo ? "false" : "true"}>本月</button>
        <button type="button" data-preset="year" aria-pressed="false">本年</button>
        <button type="button" data-preset="all" aria-pressed={data.demo ? "true" : "false"}>全部</button>
      </div>

      <div class="wk-pickers">
        <label>
          月份
          <select id="wk-month">
            <option value="all">全部</option>
          </select>
        </label>
        <label>
          起
          <input type="date" id="wk-start" />
        </label>
        <label>
          止
          <input type="date" id="wk-end" />
        </label>
      </div>
    </div>

    <p class="wk-summary" id="wk-summary">—</p>
  </section>

  <section class="container wk-panel-wrap">
    <div class="wk-panel">
      <header class="wk-panel-head">
        <div>
          <h2>每周金额</h2>
          <p class="muted">按账户拆分，正收益向上、负收益向下</p>
        </div>
        <div class="wk-aside">
          <span class="wk-legend" id="wk-legend"></span>
          <span class="wk-meta" id="wk-chart-meta">—</span>
        </div>
      </header>
      <div class="wk-chart-wrap">
        <div class="wk-chart" id="wk-chart"></div>
      </div>
    </div>
  </section>

  <section class="container wk-panel-wrap">
    <div class="wk-panel">
      <header class="wk-panel-head">
        <div>
          <h2>账户表现</h2>
          <p class="muted">所选区间内每个账户的累计金额与周均</p>
        </div>
        <span class="wk-meta" id="wk-acct-meta">—</span>
      </header>
      <div class="wk-accts" id="wk-accts">
        <p class="wk-empty">正在载入…</p>
      </div>
    </div>
  </section>

  <section class="container wk-panel-wrap">
    <div class="wk-panel">
      <header class="wk-panel-head">
        <div>
          <h2>周度明细</h2>
          <p class="muted">按周倒序，保留每一周的账户金额与备注</p>
        </div>
        <span class="wk-meta" id="wk-list-meta">—</span>
      </header>
      <div class="wk-list" id="wk-list">
        <p class="wk-empty">正在载入…</p>
      </div>
    </div>
  </section>

  <section class="container">
    <p class="wk-source">
      数据来源：MySQL 表 <code>ods_trade_周度收益</code> · 最近同步 {syncedLabel}
    </p>
  </section>
</BaseLayout>

<script type="application/json" id="wk-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

